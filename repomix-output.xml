    description:
      "Take a screenshot and analyze it with vision AI. Returns a structured description of what is visible on screen. Use when snapshot() is insufficient (e.g., extension popups, native apps).",
    inputSchema: { type: "object", properties: {} },
  },
  {
    name: "click",
    description:
      "Click an element. Priority: ref (fastest, uses Playwright CSS selector) > coordinates (x,y with xdotool) > description (slowest, uses vision AI to locate). Only provide ONE of these.",
    inputSchema: {
      type: "object",
      properties: {
