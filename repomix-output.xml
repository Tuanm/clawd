const CATEGORY_LABELS: Record<FileCategory, string> = {
  pdf: "PDF",
  csv: "CSV",
  html: "HTML",
  text: "TXT",
  code: "CODE",
  image: "IMG",
  audio: "AUD",
  video: "VID",
  other: "FILE",
};

function FileIcon({ category }: { category: FileCategory }) {
