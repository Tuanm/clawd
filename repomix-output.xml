<file path="packages/ui/src/styles.css">
/* Chat Task Agent - Slack-Style Design */

@import url("https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap");

:root {
  --accent: 15 63.1% 59.6%;
  --bg: 48 33.3% 97.1%;
  --bg-center: 0 0% 100%;
  --text: 60 2.6% 7.6%;
  --bg-main: hsl(var(--bg));
  --bg-hover: hsl(var(--bg-center) / 80%);
  --text-primary: hsl(var(--text));
  --text-secondary: hsl(var(--text) / 70%);
  --text-muted: hsl(var(--text) / 50%);
  --accent-color: hsl(var(--accent));
  --agent-color: hsl(var(--text));
  --user-color: hsl(var(--accent));
  --ui-scale: 1.25;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body,
#root {
  height: 100%;
  overflow: hidden;
}

/* Hide global scrollbars */
html::-webkit-scrollbar,
body::-webkit-scrollbar {
  display: none;
}

html,
body {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
}

body {
  font-family: "Lato", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.46668;
  -webkit-font-smoothing: antialiased;
}

/* Home page - just Clawd running */
.home-page {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at center, hsl(var(--bg-center)) 0%, hsl(var(--bg-center) / 70%) 40%, transparent 70%),
    radial-gradient(circle, hsl(var(--text) / 12%) 1px, transparent 1px);
  background-size:
    100% 100%,
    16px 16px;
  overflow: hidden;
  position: relative;
}

/* Loading state - Clawd entrance animation */
.clawd-entrance {
  animation: clawd-run-in 0.8s ease-out forwards;
  padding: 4px;
  display: flex;
  align-items: center;
}

.clawd-entrance .leg1 {
  animation: leg-run1 0.12s ease-in-out infinite;
  animation-delay: 0s;
}

.clawd-entrance .leg2 {
  animation: leg-run2 0.12s ease-in-out infinite;
  animation-delay: 0s;
}

@keyframes clawd-run-in {
  0% {
    transform: translateX(-100px);
  }
  100% {
    transform: translateX(0);
  }
}

@keyframes leg-run1 {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4px);
  }
}

@keyframes leg-run2 {
  0%,
  100% {
    transform: translateY(-4px);
  }
  50% {
    transform: translateY(0);
  }
}

.clawd-runner {
  position: absolute;
  cursor: pointer;
}

.clawd-runner.fleeing .l1 {
  animation: leg1 0.15s ease-in-out infinite;
}

.clawd-runner.fleeing .l2 {
  animation: leg2 0.15s ease-in-out infinite;
}

@keyframes leg1 {
  0%,
  66% {
    transform: translateY(0);
  }
  33%,
  100% {
    transform: translateY(-6px);
  }
}

@keyframes leg2 {
  0%,
  33%,
  100% {
    transform: translateY(0);
  }
  66% {
    transform: translateY(-6px);
  }
}

.clawd-runner .eye {
  transform-origin: center bottom;
  transform-box: fill-box;
  animation: blink 10s ease-in-out infinite;
}

/* Home page space input - centered on screen */
.home-space-input {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  background: hsl(var(--bg-center));
  border: 1px solid hsl(var(--text) / 20%);
  border-radius: 8px;
  padding: 4px 4px 4px 12px;
  box-shadow: 0 2px 12px hsl(var(--text) / 10%);
  animation: fadeIn 0.2s ease;
  z-index: 10;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.home-space-field {
  background: transparent;
  border: none;
  outline: none;
  font-size: 16px;
  color: var(--text-primary);
  font-family: "Lato", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  width: 280px;
  padding: 12px 16px;
}

.home-space-field::placeholder {
  color: var(--text-muted);
}

.home-space-send {
  width: 44px;
  height: 44px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.15s,
    color 0.15s;
}

.home-space-send:hover,
.home-space-send.has-content {
  background: hsl(15 63.1% 45%);
  color: #fff;
}

.home-space-send:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* Caught state - freeze and prepare for transition */
.clawd-caught {
  animation: clawdPulse 0.3s ease-out;
}

@keyframes clawdPulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
  }
}

/* Branding container - centered layout */
.branding-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* Branding row - horizontal layout for logo + plus + clawd */
.branding-row {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Copilot logo wrapper */
.copilot-wrapper {
  animation: copilotSlideIn 0.4s ease-out;
}

@keyframes copilotSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.copilot-logo {
  display: block;
}

/* Plus icon wrapper */
.plus-wrapper {
  animation: plusFadeIn 0.4s ease-out 0.15s both;
  min-width: 24px;
  min-height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes plusFadeIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.plus-icon {
  display: block;
}

/* Clawd brand wrapper */
.clawd-brand-wrapper {
  animation: clawdSlideIn 0.4s ease-out 0.1s both;
}

@keyframes clawdSlideIn {
  from {
    opacity: 0;
    transform: translateX(20px) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

/* Branding input - positioned below branding row */
.branding-input {
  position: relative;
  top: auto;
  left: auto;
  transform: none;
  animation: inputSlideUp 0.4s ease-out 0.3s both;
}

@keyframes inputSlideUp {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Assembling state - Claw'd running to join */
.clawd-assembling {
  z-index: 20;
}

/* When Claw'd has settled into position, stop leg animation */
.clawd-settled {
  z-index: 20;
}

/* Remove ALL animations for assembling state - only running Claw'd should animate */
.branding-container.assembling,
.branding-container.assembling .copilot-wrapper,
.branding-container.assembling .plus-wrapper,
.branding-container.assembling .clawd-brand-wrapper,
.branding-container.assembling .clawd-frame-wrapper,
.branding-container.assembling .assembling-input {
  animation: none;
  transform: none;
  opacity: 1;
}

/* Assembling input - visible but disabled/dimmed */
.assembling-input {
  opacity: 0.5;
}

.assembling-input input,
.assembling-input button {
  cursor: not-allowed;
}

/* Frame wrapper for Claw'd placeholder */
.clawd-frame-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 66px;
  min-height: 52px;
}

/* Frame animations - pulse slightly to indicate target */
.clawd-frame {
  opacity: 0.6;
  animation: framePulse 1.5s ease-in-out infinite;
}

@keyframes framePulse {
  0%,
  100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.7;
  }
}

/* Responsive adjustments */
@media (max-width: 480px) {
  .branding-row {
    gap: 12px;
  }

  .copilot-logo {
    width: 50px;
    height: 40px;
  }

  .plus-icon {
    width: 18px;
    height: 18px;
  }

  .clawd-brand-wrapper svg,
  .clawd-frame {
    width: 50px;
    height: 40px;
  }

  /* Running Claw'd also scales on mobile */
  .clawd-runner svg {
    width: 50px;
    height: 40px;
  }

  .branding-container {
    gap: 20px;
  }
}

/* Dot pattern background */
.app {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  max-width: 100%;
  position: relative;
  background:
    radial-gradient(circle at center, hsl(var(--bg-center)) 0%, hsl(var(--bg-center) / 70%) 40%, transparent 70%),
    radial-gradient(circle, hsl(var(--text) / 12%) 1px, transparent 1px);
  background-size:
    100% 100%,
    16px 16px;
  transform: scale(var(--ui-scale, 1));
  transform-origin: top left;
  width: calc(100% / var(--ui-scale, 1));
  height: calc(100% / var(--ui-scale, 1));
}

/* Loading state */
.app.loading {
  overflow: hidden;
  height: 100vh;
  width: 100vw;
}

/* Article page scrollable wrapper */
.messages-wrapper.article-scrollable {
  overflow-y: auto;
  flex: 1;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  background: var(--bg-main);
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.clawd-home-link {
  display: flex;
  align-items: center;
  cursor: pointer;
  transition: opacity 0.15s;
}

.clawd-home-link:hover {
  opacity: 0.7;
}

/* Logo button in header */
.clawd-logo-button {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  border-radius: 6px;
  transition:
    opacity 0.15s,
    background-color 0.15s;
}

.clawd-logo-button:hover {
  opacity: 0.8;
}

/* Header channel name (static, no dropdown) */
.header-channel-name {
  font-size: 14px;
  font-weight: 400;
  color: var(--text-primary);
}

/* Red dot indicator when unread messages exist */
.clawd-logo-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.clawd-unread-dot {
  position: absolute;
  top: -5px;
  right: -5px;
  width: 6px;
  height: 6px;
  background: hsl(0 80% 55%);
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

/* ============================================================================
   Channel Dialog (opened by clicking logo)
   ============================================================================ */
.channel-dialog-overlay.modal-overlay {
  background: hsl(var(--text) / 30%);
  backdrop-filter: blur(2px);
}

.channel-dialog {
  background: hsl(var(--bg-center));
  border: 1px solid hsl(var(--border));
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  min-width: 300px;
  max-width: 420px;
  width: 90vw;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: context-menu-appear 0.15s ease-out;
}

.channel-dialog-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 20px 12px;
  border-bottom: 1px solid hsl(var(--border));
}

.channel-dialog-title {
  font-size: 15px;
  font-weight: 600;
  color: hsl(var(--text));
  flex: 1;
}

.channel-dialog-plus-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: 1px solid hsl(var(--border));
  border-radius: 6px;
  background: transparent;
  color: hsl(var(--text) / 60%);
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    color 0.15s ease,
    border-color 0.15s ease;
  flex-shrink: 0;
}

.channel-dialog-plus-btn:hover {
  background-color: hsl(15 63.1% 59.6% / 10%);
  color: hsl(15 63.1% 59.6%);
  border-color: hsl(15 63.1% 59.6% / 40%);
}

.channel-dialog-list {
  overflow-y: auto;
  padding: 6px 0;
  flex: 1;
}

.channel-dialog-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 10px 20px;
  border: none;
  background: transparent;
  font-size: 14px;
  color: hsl(var(--text));
  text-align: left;
}

.channel-dialog-item.active {
  background-color: hsl(15 63.1% 59.6% / 8%);
  cursor: default;
}

.channel-dialog-item.active .channel-dialog-item-name {
  font-weight: 600;
}

.channel-dialog-item-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-dialog-item-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin-left: auto;
}

.channel-dialog-agents {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Swipeable channel row */
.channel-dialog-swipe-row {
  position: relative;
  overflow: hidden;
}

.channel-dialog-swipe-row.removing {
  opacity: 0;
  max-height: 0;
  transition:
    opacity 0.2s ease,
    max-height 0.2s ease;
}

.channel-dialog-swipe-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: hsl(0 72% 51%);
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}

.channel-dialog-swipe-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 10px 20px;
  background: hsl(var(--bg-center));
  font-size: 14px;
  color: hsl(var(--text));
  text-align: left;
  cursor: pointer;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}

.channel-dialog-swipe-content:hover {
  background-color: hsl(var(--bg));
}

/* Agent dialog -- reuses stream-dialog structure */
.agent-dialog {
  width: min(90vw, 460px);
  max-height: 70vh;
}

.agent-dialog-body {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px;
  font-family: Lato, sans-serif;
  font-size: 14px;
}

.agent-dialog-error {
  color: hsl(0 72% 51%);
  font-size: 12px;
  padding: 8px 0 0;
}

/* Plus button in avatar bar */
.agent-add-btn .agent-add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 18px;
  color: hsl(var(--text) / 40%);
}

.agent-add-btn.active .agent-add-icon {
  color: hsl(var(--text));
}

/* Shared input field layout for both detail view and add form */
.agent-fields {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.agent-buttons {
  display: flex;
  gap: 10px;
}

.agent-field-input {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid hsl(var(--text) / 12%);
  border-radius: 8px;
  background: hsl(var(--text) / 3%);
  color: hsl(var(--text));
  font-size: 14px;
  font-family: Lato, sans-serif;
  outline: none;
  transition: border-color 0.15s;
  box-sizing: border-box;
}

.agent-field-input:focus {
  border-color: hsl(var(--accent));
}

.agent-field-input::placeholder {
  color: hsl(var(--text) / 30%);
}

.agent-field-input[readonly] {
  cursor: default;
  opacity: 0.7;
}

.agent-field-input[readonly]:focus {
  border-color: hsl(var(--text) / 12%);
}

/* Identity textarea — expandable like the input area */
.agent-identity-input {
  min-height: 60px;
  max-height: 200px;
  resize: vertical;
  line-height: 1.5;
  font-size: 13px;
  white-space: pre-wrap;
  field-sizing: content;
}

/* Browse row: input + browse button */
.agent-field-browse {
  display: flex;
  gap: 6px;
}

.agent-field-browse .agent-field-input {
  flex: 1;
  min-width: 0;
}

.agent-field-browse-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  flex-shrink: 0;
  border: 1px solid hsl(var(--text) / 12%);
  border-radius: 8px;
  background: hsl(var(--text) / 3%);
  color: hsl(var(--text) / 45%);
  cursor: pointer;
  transition: all 0.15s;
}

.agent-field-browse-btn:hover {
  border-color: hsl(var(--accent));
  color: hsl(var(--accent));
  background: hsl(var(--accent) / 5%);
}

/* Shared action button styles */
.agent-action-btn {
  padding: 8px 18px;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  font-family: Lato, sans-serif;
  cursor: pointer;
  transition: all 0.15s;
  align-self: flex-start;
}

.agent-action-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.agent-action-btn--accent {
  background: hsl(var(--accent));
  color: #fff;
}

.agent-action-btn--accent:hover:not(:disabled) {
  opacity: 0.88;
}

.agent-action-btn--warning {
  background: none;
  border: 1px solid hsl(38 92% 50% / 40%);
  color: hsl(38 92% 50%);
}

.agent-action-btn--warning:hover:not(:disabled) {
  background: hsl(38 92% 50% / 10%);
  border-color: hsl(38 92% 50% / 60%);
}

.agent-action-btn--danger {
  background: none;
  border: 1px solid hsl(0 72% 51% / 30%);
  color: hsl(0 72% 51%);
}

.agent-action-btn--danger:hover:not(:disabled) {
  background: hsl(0 72% 51% / 8%);
  border-color: hsl(0 72% 51% / 50%);
}

/* Minimal folder browser */
.agent-browser {
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 8px;
  overflow: hidden;
}

.agent-browser-head {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-bottom: 1px solid hsl(var(--text) / 8%);
  background: hsl(var(--text) / 2%);
}

.agent-browser-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border: none;
  border-radius: 4px;
  background: none;
  color: hsl(var(--text) / 50%);
  cursor: pointer;
  flex-shrink: 0;
}

.agent-browser-back:hover {
  background: hsl(var(--text) / 6%);
  color: hsl(var(--text));
}

.agent-browser-path {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
  color: hsl(var(--text) / 55%);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-browser-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border: none;
  border-radius: 4px;
  background: none;
  color: hsl(var(--text) / 50%);
  cursor: pointer;
  flex-shrink: 0;
}

.agent-browser-check:hover {
  background: hsl(var(--text) / 6%);
  color: hsl(var(--accent));
}

.agent-browser-list {
  max-height: 160px;
  overflow-y: auto;
}

.agent-browser-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 5px 10px;
  border: none;
  background: none;
  color: hsl(var(--text) / 80%);
  font-size: 13px;
  font-family: Lato, sans-serif;
  cursor: pointer;
  transition: background 0.1s;
}

.agent-browser-item:hover {
  background: hsl(var(--text) / 5%);
  color: hsl(var(--text));
}

.agent-browser-empty {
  padding: 12px 10px;
  text-align: center;
  font-size: 12px;
  color: hsl(var(--text) / 35%);
}

.connection-indicator.clickable {
  cursor: pointer;
  border-radius: 4px;
  padding: 2px;
  transition: background 0.15s;
}

.connection-indicator.clickable:hover {
  background: hsl(0 0% 95%);
}

@media (prefers-color-scheme: dark) {
  .connection-indicator.clickable:hover {
    background: hsl(0 0% 20%);
  }
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at center, hsl(var(--bg-center)) 0%, hsl(var(--bg-center) / 70%) 40%, transparent 70%),
    radial-gradient(circle, hsl(var(--text) / 12%) 1px, transparent 1px);
  background-size:
    100% 100%,
    16px 16px;
  background-color: hsl(var(--bg-center));
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.connection-indicator {
  display: flex;
  align-items: center;
}

.connection-indicator svg {
  width: 20px;
  height: 16px;
}

.connection-indicator.reconnecting svg {
  animation: flash-connection 0.8s ease-in-out infinite;
}

/* Notification toggle button */
.notification-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
  color: hsl(0 0% 60%);
  transition:
    color 0.2s,
    background 0.2s;
}

.notification-toggle:hover {
  background: hsl(0 0% 95%);
  color: hsl(0 0% 40%);
}

.notification-toggle.enabled {
  color: hsl(15 63.1% 59.6%);
}

.notification-toggle.enabled:hover {
  background: hsl(15 63.1% 95%);
}

@keyframes flash-connection {
  0%,
  100% {
    fill: hsl(15 63.1% 59.6%);
  }
  50% {
    fill: hsl(0 0% 50%);
  }
}

.online-agents {
  display: flex;
  align-items: center;
  gap: 4px;
}

.online-agent {
  display: flex;
  align-items: center;
  opacity: 0.8;
  transition: opacity 0.15s ease;
}

.online-agent.clickable {
  cursor: pointer;
}

.online-agent:hover {
  opacity: 1;
}

/* Messages - Slack style with avatars */
.messages {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16px 0 80px 0; /* Extra bottom padding for input clearance */
}

.messages::-webkit-scrollbar {
  width: 8px;
}

.messages::-webkit-scrollbar-track {
  background: transparent;
}

.messages::-webkit-scrollbar-thumb {
  background: hsl(var(--text) / 20%);
  border-radius: 4px;
}

.messages::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--text) / 30%);
}

/* Scroll to bottom button */
.scroll-to-bottom {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  transition:
    transform 0.2s,
    background-color 0.2s,
    opacity 0.2s;
  z-index: 10;
}

.scroll-to-bottom:hover {
  background: #f5f5f5;
  transform: scale(1.05);
}

.scroll-to-bottom svg {
  color: var(--text-secondary);
}

.scroll-to-bottom.has-unread {
  border-color: hsl(0 80% 55%);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.15),
    0 0 0 1px hsl(0 80% 55% / 0.3);
}

/* Messages wrapper for scroll button positioning */
.messages-wrapper {
  flex: 1;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Loading more indicator */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  color: var(--text-muted);
  font-size: 13px;
}

.loading-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid hsl(var(--text) / 20%);
  border-top-color: var(--accent-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* System messages (join, notifications) */
.message-system {
  text-align: center;
  padding: 0 24px;
  margin: 0 16px;
}

.message-system-text {
  font-size: 13px;
  color: var(--text-muted);
}

.message {
  display: flex;
  flex-direction: row;
  gap: 12px;
  padding: 0 24px;
  margin: 0 16px;
  background: transparent;
  border-radius: 8px;
  border: 1px solid transparent;
  transition:
    background 0.1s ease,
    border-color 0.1s ease,
    box-shadow 0.1s ease;
  position: relative;
}

/* Hover card effect - use pseudo-element for background */
.message {
  position: relative;
  isolation: isolate; /* Create stacking context so z-index:-1 stays within message */
}

.message::before {
  content: "";
  position: absolute;
  top: 0;
  /* Extend full-width: compensate for padding (24px) + margin (16px) = 40px each side */
  left: -40px;
  right: -40px;
  bottom: 0;
  border-radius: 0; /* No border-radius for full-width */
  background: transparent;
  z-index: -1;
  pointer-events: none;
}

.message:hover::before {
  background: #ffffff;
}

/* Block start messages - hover stays flush (same as continuation messages) */
/* The 16px margin-top gap between blocks remains unhighlighted on hover */

/* Shrink hover background for continuation messages */
.message.continuation:has(+ .message.continuation)::before {
  /* No compensation needed - no negative margins */
}

/* Last message in a single-message block - no extra hover padding */
.message:not(.continuation):not(:has(+ .message.continuation)):hover::before {
  bottom: 0;
}

/* Last continuation in a multi-message block - no extra hover padding */
.message.continuation:not(:has(+ .message.continuation)):hover::before {
  bottom: 0;
}

.message:hover .message-link-btn {
  opacity: 1;
}

/* Message link button (copy reference) - HIDDEN */
.message-link-btn {
  display: none;
}

.message-link-btn svg {
  width: 14px;
  height: 14px;
}

.message-link-btn:hover {
  color: var(--accent-color);
}

.message-link-btn:active {
  transform: scale(0.9);
}

.message-link-btn.copied {
  animation: link-success 0.4s ease;
  color: var(--accent-color);
}

@keyframes link-success {
  0% {
    transform: scale(1);
  }
  25% {
    transform: scale(1.2);
  }
  50% {
    transform: scale(0.95);
  }
  100% {
    transform: scale(1);
  }
}

/* Pending messages (optimistic UI) */
.message.pending {
  opacity: 0.7;
}

.message.pending.sending {
  animation: sending-pulse 1.5s ease-in-out infinite;
}

.message.pending.sent {
  opacity: 1;
  /* Normal appearance - no animation, will be replaced by real message */
}

.message.pending.failed {
  opacity: 0.85;
}

.message.pending.failed .message-content,
.message.pending.failed .message-files {
  color: hsl(0 60% 50%);
}

.message.pending.failed .message-time {
  color: hsl(0 60% 50%);
}

@keyframes sending-pulse {
  0%,
  100% {
    opacity: 0.5;
  }
  50% {
    opacity: 0.8;
  }
}

/* Agent "Thinking..." state - similar to user "Sending..." */
.message.agent.thinking {
  animation: thinking-pulse 1.5s ease-in-out infinite;
}

.message.agent.thinking .message-time {
  font-style: italic;
  color: var(--text-muted);
}

.message.agent.thinking .message-sender {
  color: var(--text-muted);
}

@keyframes thinking-pulse {
  0%,
  100% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
}

/* Thinking tokens section */
.thinking-section {
  margin-bottom: 12px;
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  overflow: hidden;
}

.thinking-summary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: var(--bg-secondary);
  cursor: pointer;
  user-select: none;
  font-size: 0.85rem;
}

.thinking-summary:hover {
  background: var(--bg-hover);
}

.thinking-label {
  font-weight: 500;
  color: var(--text-muted);
}

.thinking-length {
  color: var(--text-disabled);
  font-size: 0.75rem;
}

.thinking-content {
  padding: 12px;
  background: var(--bg-tertiary);
  max-height: 300px;
  overflow-y: auto;
}

.thinking-content pre {
  margin: 0;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 0.8rem;
  line-height: 1.5;
  color: var(--text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

.message-retry-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 4px;
  border: none;
  background: hsl(0 60% 95%);
  border-radius: 4px;
  cursor: pointer;
  color: hsl(0 60% 40%);
  opacity: 0;
  transition: all 0.15s ease;
}

.message.pending.failed:hover .message-retry-btn {
  opacity: 1;
}

.message-retry-btn:hover {
  background: hsl(0 60% 90%);
  color: hsl(0 60% 30%);
}

.pending-files {
  opacity: 0.7;
}

.pending-file {
  display: inline-block;
  padding: 4px 8px;
  background: hsl(var(--text) / 10%);
  border-radius: 4px;
  font-size: 12px;
  margin-right: 4px;
}

/* First message of a block (has avatar) - spacious gap between blocks */
.message:not(.continuation) {
  margin-top: 16px;
  padding-top: 4px;
  padding-bottom: 4px;
}

/* Remove top margin from first message in the list */
.message:not(.continuation):first-child {
  margin-top: 0;
}

/* Continuation messages (same author, close in time) */
.message.continuation {
  padding-top: 2px;
  padding-bottom: 2px;
  border-top: none;
  border-bottom: none;
  /* Keep same total left offset as normal messages (avatar area preserved) */
}

/* Continuation messages get tight spacing - no negative margins to avoid overlapping */
.message.continuation:has(+ .message.continuation) {
  margin-bottom: 0;
}

/* Last continuation in a block */
.message.continuation:not(:has(+ .message.continuation)) {
  margin-bottom: 0;
}

.message.continuation .message-avatar {
  visibility: hidden;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

/* Hide timestamp on continuation messages - only first message shows time */
.message.continuation .message-time {
  display: none;
}

/* Continuation messages still get hover effect via .message::before */

/* Avatar - round like Slack */
.message-avatar {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 6px;
  overflow: hidden;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.message-avatar svg {
  width: 32px;
  height: 26px;
}

/* Clawd animation */
.message-avatar .clawd-eye {
  transform-origin: center bottom;
  transform-box: fill-box;
  animation: blink 10s ease-in-out infinite;
}

@keyframes blink {
  0%,
  96%,
  100% {
    transform: scaleY(1);
  }
  98% {
    transform: scaleY(0.15);
  }
}

/* Clickable avatar for copying mentions */
.message-avatar.clickable {
  cursor: pointer;
  transition:
    transform 0.1s,
    opacity 0.1s;
}

.message-avatar.clickable:hover {
  transform: scale(1.05);
}

.message-avatar.clickable:active {
  transform: scale(0.95);
}

.message-avatar.copied {
  animation: avatarCopied 0.4s ease;
}

@keyframes avatarCopied {
  0% {
    transform: scale(1);
  }
  30% {
    transform: scale(0.9);
  }
  60% {
    transform: scale(1.05);
    opacity: 0.7;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.message-body {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.message-sender {
  font-size: 15px;
  font-weight: 900;
}

.message.agent .message-sender {
  color: var(--text-primary);
}

.message.user .message-sender {
  color: var(--text-primary);
}

.message-time {
  font-size: 12px;
  color: var(--text-muted);
  white-space: nowrap;
  font-weight: 400;
}

.message-content {
  font-size: 15px;
  color: var(--text-primary);
  line-height: 1.46668;
  word-wrap: break-word;
}

/* Each logical content block (text, code, image, mermaid, iframe) gets subtle spacing */
.message-block {
  margin: 6px 0;
}

.message-block:first-child {
  margin-top: 0;
}

.message-block:last-child {
  margin-bottom: 0;
}

.message-content p {
  margin: 0 0 4px;
}

.message-content p:last-child {
  margin-bottom: 0;
}

.message-content ul,
.message-content ol {
  margin: 4px 0;
  padding-left: 20px;
}

.message-content code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 12px;
  background: #f4f4f4;
  padding: 2px 4px;
  border-radius: 3px;
  color: #e01e5a;
}

.message-content pre {
  background: #f4f4f4;
  padding: 12px;
  border-radius: 4px;
  overflow-x: auto;
  margin: 8px 0;
  position: relative;
}

/* Code block wrapper with copy button */
.code-block-wrapper {
  position: relative;
}

.code-block-wrapper pre {
  margin: 0;
}

.code-copy-btn {
  position: absolute;
  top: 4px;
  right: 4px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 3px 5px;
  cursor: pointer;
  opacity: 0;
  transition:
    opacity 0.2s,
    background-color 0.2s,
    transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.code-block-wrapper:hover .code-copy-btn,
.code-copy-btn:focus {
  opacity: 1;
}

.code-copy-btn:hover {
  background: #f0f0f0;
}

.code-copy-btn.copied {
  opacity: 1;
  background: #d4edda;
  border-color: #28a745;
  color: #28a745;
  transform: scale(1.05);
}

.code-copy-btn svg {
  width: 12px;
  height: 12px;
}

.message-content pre code {
  background: none;
  padding: 0;
  color: var(--text-primary);
}

.message-content strong {
  font-weight: 700;
}

.message-files {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.message-file {
  font-size: 13px;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.1s;
}

.message-file:hover {
  color: var(--text-primary);
  text-decoration: underline;
}

/* Article Card */
.message-article-card {
  display: flex;
  gap: 12px;
  margin-top: 12px;
  padding: 12px;
  background: #ffffff;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
}

.message-article-card:hover {
  border-color: hsl(var(--accent) / 30%);
}

.article-card-thumbnail {
  width: 80px;
  height: 60px;
  flex-shrink: 0;
  border-radius: 4px;
  overflow: hidden;
  background: hsl(var(--text) / 8%);
}

.article-card-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article-card-content {
  flex: 1;
  min-width: 0;
}

.article-card-title {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-primary);
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-card-description {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-card-meta {
  font-size: 12px;
  color: var(--text-muted);
}

.article-card-author {
  font-style: italic;
}

/* Sub-space Card */
.message-subspace-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.15s;
  margin-top: 8px;
}

.message-subspace-card:hover {
  background-color: var(--hover-bg, rgba(0, 0, 0, 0.04));
}

.subspace-card-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

.subspace-card-content {
  flex: 1;
  min-width: 0;
}

.subspace-card-title {
  font-weight: 600;
  font-size: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subspace-card-description {
  font-size: 12px;
  color: var(--text-secondary, #64748b);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 2px;
}

.subspace-card-status {
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.subspace-card-failed {
  background-color: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.3);
}

.subspace-card-completed {
  background-color: rgba(34, 197, 94, 0.08);
  border-color: rgba(34, 197, 94, 0.3);
}

.subspace-status-active {
  color: #3b82f6;
}
.subspace-status-completed {
  color: #22c55e;
}
.subspace-status-failed {
  color: #ef4444;
}
.subspace-status-timed_out {
  color: #f97316;
}

/* Workspace desktop preview card */
.message-workspace-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.15s;
  margin-top: 8px;
}

.message-workspace-card:hover {
  background-color: var(--hover-bg, rgba(0, 0, 0, 0.04));
}

.workspace-card-content {
  flex: 1;
  min-width: 0;
}

.workspace-card-title {
  font-weight: 600;
  font-size: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workspace-card-description {
  font-size: 12px;
  color: var(--text-secondary, #64748b);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 2px;
}

.workspace-card-action {
  font-size: 12px;
  color: #3b82f6;
  margin-top: 4px;
  font-weight: 500;
}

.workspace-card-completed {
  background-color: rgba(100, 116, 139, 0.08);
  border-color: rgba(100, 116, 139, 0.3);
}

.workspace-card-waiting {
  background-color: rgba(251, 191, 36, 0.08);
  border-color: rgba(251, 191, 36, 0.3);
}

.workspace-card-running {
  background-color: rgba(34, 197, 94, 0.08);
  border-color: rgba(34, 197, 94, 0.3);
}

/* Tool Result Card — scheduled tool call results */
.message-tool-result-card {
  display: flex;
  flex-direction: column;
  padding: 12px 16px;
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.15s;
  margin-top: 8px;
  user-select: none;
}
.message-tool-result-card:hover {
  filter: brightness(0.97);
}
.tool-result-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
}
.tool-result-card-content {
  flex: 1;
  min-width: 0;
}
.tool-result-card-title {
  font-weight: 600;
  font-size: 14px;
  font-family: monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tool-result-card-description {
  font-size: 12px;
  color: var(--text-secondary, #64748b);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 2px;
}
/* Status colors */
.tool-result-card-succeeded {
  background-color: rgba(34, 197, 94, 0.08);
  border-color: rgba(34, 197, 94, 0.3);
}
.tool-result-card-failed {
  background-color: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.3);
}
.tool-result-card-running {
  background-color: rgba(251, 191, 36, 0.08);
  border-color: rgba(251, 191, 36, 0.3);
}
/* Expanded details */
.tool-result-card-details {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 10px;
  border-top: 1px solid var(--border-color, #e2e8f0);
  padding-top: 10px;
}
.tool-result-card-section-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--text-secondary, #64748b);
  margin-bottom: 4px;
  letter-spacing: 0.5px;
}
.tool-result-card-json {
  font-family: monospace;
  font-size: 12px;
  background: var(--bg-tertiary, rgba(0, 0, 0, 0.04));
  border-radius: 4px;
  padding: 8px 10px;
  margin: 0;
  max-height: 200px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
}

/* Space Header */
.space-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 16px;
  border-bottom: 1px solid var(--border-color, #e2e8f0);
  background: var(--bg-secondary, #f8fafc);
}

.space-back-btn {
  background: none;
  border: none;
  color: var(--text-link, #3b82f6);
  cursor: pointer;
  font-size: 14px;
  padding: 4px 8px;
  border-radius: 4px;
}

.space-back-btn:hover {
  background: var(--hover-bg, rgba(0, 0, 0, 0.04));
}

.space-header-title {
  font-weight: 600;
  font-size: 14px;
}

.space-locked-banner {
  padding: 8px 16px;
  background: var(--bg-warning, #fef3c7);
  color: var(--text-warning, #92400e);
  font-size: 13px;
  text-align: center;
  border-bottom: 1px solid var(--border-color, #e2e8f0);
}

/* Article Page */
.article-page {
  min-height: 100vh;
  padding: 40px 20px;
  background: var(--bg-main);
  overflow-y: auto;
  height: 100vh;
}

/* Article content card (standalone page) */
.article-content-card {
  max-width: 700px;
  margin: 0 auto;
  padding: 24px;
  background: #ffffff;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.article-card-date {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.article-card-body {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-primary);
}

.article-card-body p {
  margin: 0 0 4px;
}

.article-card-body p:last-child {
  margin-bottom: 0;
}

.article-card-body ul,
.article-card-body ol {
  margin: 4px 0;
  padding-left: 20px;
}

.article-card-body code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 12px;
  background: #f4f4f4;
  padding: 2px 4px;
  border-radius: 3px;
  color: #e01e5a;
}

.article-card-body pre {
  background: #f4f4f4;
  padding: 12px;
  border-radius: 4px;
  overflow-x: auto;
  margin: 8px 0;
  position: relative;
}

.article-card-body table {
  border-collapse: collapse;
  width: 100%;
  font-size: 14px;
}

.article-card-body th,
.article-card-body td {
  border: 1px solid #ddd;
  padding: 8px 12px;
  text-align: left;
}

.article-card-body th {
  background: #f5f5f5;
  font-weight: 700;
}

.article-card-body tr:nth-child(even) {
  background: #fafafa;
}

.article-card-author {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid hsl(var(--text) / 10%);
}

.article-card-author .message-avatar {
  width: 24px;
  height: 24px;
  cursor: help;
}

.article-card-author-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
}

.article-card-loading,
.article-card-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
  color: var(--text-muted);
}

/* Article Modal (in chat) */
.article-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.article-modal {
  position: relative;
  max-width: 900px;
  width: 90%;
  max-height: 90vh;
  margin: auto;
  overflow-y: auto;
  padding: 32px;
  background: #ffffff;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 12px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
  animation: scaleIn 0.2s ease;
}

.article-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: var(--text-muted);
  border-radius: 4px;
  transition: color 0.15s;
}

.article-modal-close:hover {
  color: var(--text-primary);
}

.article-modal-date {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.article-modal-body {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-primary);
}

.article-modal-body p {
  margin: 0 0 4px;
}

.article-modal-body p:last-child {
  margin-bottom: 0;
}

.article-modal-body ul,
.article-modal-body ol {
  margin: 4px 0;
  padding-left: 20px;
}

.article-modal-body code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 12px;
  background: #f4f4f4;
  padding: 2px 4px;
  border-radius: 3px;
  color: #e01e5a;
}

.article-modal-body pre {
  background: #f4f4f4;
  padding: 12px;
  border-radius: 4px;
  overflow-x: auto;
  margin: 8px 0;
  position: relative;
}

.article-modal-body table {
  border-collapse: collapse;
  width: 100%;
  font-size: 14px;
}

.article-modal-body th,
.article-modal-body td {
  border: 1px solid #ddd;
  padding: 8px 12px;
  text-align: left;
}

.article-modal-body th {
  background: #f5f5f5;
  font-weight: 700;
}

.article-modal-body tr:nth-child(even) {
  background: #fafafa;
}

.article-modal-author {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid hsl(var(--text) / 10%);
}

.article-modal-author-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
}

.article-modal-loading,
.article-modal-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
  color: var(--text-muted);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.article-container {
  max-width: 800px;
  margin: 0 auto;
}

.article-header {
  margin-bottom: 32px;
}

.article-hero {
  width: 100%;
  height: 300px;
  margin-bottom: 24px;
  border-radius: 12px;
  overflow: hidden;
  background: hsl(var(--text) / 5%);
}

.article-hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article-title {
  font-size: 36px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
  line-height: 1.2;
}

.article-description {
  font-size: 18px;
  color: var(--text-secondary);
  margin-bottom: 20px;
  line-height: 1.5;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  font-size: 14px;
  color: var(--text-muted);
}

.article-author {
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.article-author-name {
  font-weight: 500;
}

.article-date {
  font-style: italic;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.article-tag {
  padding: 4px 10px;
  background: hsl(var(--accent) / 10%);
  color: hsl(var(--accent));
  border-radius: 12px;
  font-size: 12px;
  font-weight: 500;
}

.article-content {
  font-size: 16px;
  line-height: 1.7;
  color: var(--text-primary);
}

.article-content p {
  margin-bottom: 16px;
}

.article-content h1,
.article-content h2,
.article-content h3,
.article-content h4,
.article-content h5,
.article-content h6 {
  margin-top: 32px;
  margin-bottom: 16px;
  font-weight: 600;
  line-height: 1.3;
}

.article-content h1 {
  font-size: 28px;
}

.article-content h2 {
  font-size: 24px;
}

.article-content h3 {
  font-size: 20px;
}

.article-content ul,
.article-content ol {
  margin-bottom: 16px;
  padding-left: 24px;
}

.article-content li {
  margin-bottom: 8px;
}

.article-content pre {
  background: hsl(var(--text) / 5%);
  padding: 16px;
  border-radius: 8px;
  overflow-x: auto;
  margin: 16px 0;
}

.article-content code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 14px;
}

.article-content .code-inline {
  background: hsl(var(--text) / 8%);
  padding: 2px 6px;
  border-radius: 4px;
}

.article-content blockquote {
  border-left: 4px solid hsl(var(--accent));
  padding-left: 16px;
  margin: 16px 0;
  color: var(--text-secondary);
  font-style: italic;
}

.article-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 16px 0;
}

.article-content th,
.article-content td {
  border: 1px solid hsl(var(--text) / 15%);
  padding: 10px 14px;
  text-align: left;
}

.article-content th {
  background: hsl(var(--text) / 5%);
  font-weight: 600;
}

.article-content img {
  max-width: 100%;
  border-radius: 8px;
  margin: 16px 0;
}

.article-content a {
  color: hsl(var(--accent));
  text-decoration: none;
}

.article-content a:hover {
  text-decoration: underline;
}

.article-loading,
.article-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  font-size: 18px;
  color: var(--text-secondary);
}

.article-error {
  color: hsl(0 72% 51%);
}

/* HTML Preview */
.html-preview {
  margin-top: 12px;
  border: 1px solid hsl(var(--text) / 15%);
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}

.html-preview-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: hsl(var(--bg));
  border-bottom: 1px solid hsl(var(--text) / 10%);
}

.html-preview-label {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.html-preview-fullscreen {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--text-muted);
  font-size: 12px;
  cursor: pointer;
  transition:
    background 0.1s,
    color 0.1s;
}

.html-preview-fullscreen:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.html-preview-frame {
  width: 100%;
  height: 300px;
  border: none;
  background: #fff;
}

/* Image attachments */
.message-image-link {
  display: block;
  cursor: pointer;
}

.message-image {
  max-width: 300px;
  max-height: 200px;
  border-radius: 8px;
  cursor: pointer;
  transition: opacity 0.15s;
}

.message-image:hover {
  opacity: 0.9;
}

/* Lightbox overlay */
.lightbox-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  cursor: pointer;
  padding: 60px 20px 80px;
  box-sizing: border-box;
}

.lightbox-image {
  max-width: 90vw;
  max-height: calc(100vh - 160px);
  object-fit: contain;
  border-radius: 4px;
  cursor: default;
  box-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
}

.lightbox-close {
  position: absolute;
  top: 16px;
  right: 20px;
  background: transparent;
  border: none;
  color: white;
  font-size: 36px;
  cursor: pointer;
  padding: 8px 16px;
  line-height: 1;
  opacity: 0.8;
  transition: opacity 0.15s;
}

.lightbox-close:hover {
  opacity: 1;
}

.lightbox-open-new {
  position: absolute;
  bottom: 64px; /* above the zoom toolbar */
  left: 50%;
  transform: translateX(-50%);
  color: white;
  background: rgba(255, 255, 255, 0.1);
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 14px;
  text-decoration: none;
  opacity: 0.8;
  transition:
    opacity 0.15s,
    background 0.15s;
}

.lightbox-open-new:hover {
  opacity: 1;
  background: rgba(255, 255, 255, 0.2);
}

.lightbox-mermaid {
  max-width: 90vw;
  max-height: calc(100vh - 80px);
  overflow: auto;
  background: hsl(var(--bg-center, 0 0% 100%));
  border-radius: 8px;
  padding: 24px;
  box-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
}

.lightbox-mermaid svg {
  max-width: 100%;
  height: auto;
}

.lightbox-toolbar {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  background: hsl(0 0% 0% / 60%);
  backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 24px;
  z-index: 10;
}

.lightbox-btn {
  background: none;
  border: none;
  color: white;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
  display: flex;
  align-items: center;
}

.lightbox-btn:hover {
  background: hsl(0 0% 100% / 20%);
}

.lightbox-zoom-level {
  color: white;
  font-size: 12px;
  min-width: 40px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.mermaid-diagram--zoomable:hover {
  opacity: 0.9;
}

.message-reactions {
  display: flex;
  gap: 4px;
  margin-top: 4px;
}

.reaction {
  font-size: 12px;
  padding: 2px 6px;
  background: hsl(var(--bg));
  border-radius: 12px;
  color: var(--text-secondary);
}

/* Seen indicator */
.message-seen {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-top: 4px;
  position: relative;
  z-index: 1; /* Stay above hover backgrounds from adjacent messages */
}

.message-seen .seen-icon {
  display: inline-flex;
  opacity: 0.85;
}

/* Hibernate banner - shown above composer when agent is sleeping */
.hibernate-banner {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: hsl(0 0% 95%);
  border: 1px solid hsl(var(--text) / 20%);
  border-bottom: none;
  border-radius: 8px 8px 0 0;
  color: hsl(var(--text) / 60%);
  font-size: 14px;
}

.hibernate-banner svg {
  flex-shrink: 0;
}

/* Sleeping Claw'd animation in banner */
.sleeping-clawd {
  display: flex;
  align-items: center;
}

.sleeping-clawd .clawd-eye {
  transform-origin: center bottom;
  transform-box: fill-box;
  animation: sleeping-blink 3s ease-in-out infinite;
}

@keyframes sleeping-blink {
  0%,
  90%,
  100% {
    transform: scaleY(1);
  }
  95% {
    transform: scaleY(0.3);
  }
}

/* ===== Streaming avatar animation (when agent is actively typing) ===== */
.clawd-avatar-streaming {
  display: inline-block;
}

.clawd-avatar-streaming .clawd-avatar-svg {
  animation: clawd-avatar-bounce 0.4s ease-in-out infinite;
}

.clawd-avatar-streaming .clawd-leg-1 {
  transform-origin: center top;
  animation: clawd-leg-run-1 0.15s ease-in-out infinite;
}

.clawd-avatar-streaming .clawd-leg-2 {
  transform-origin: center top;
  animation: clawd-leg-run-2 0.15s ease-in-out infinite;
}

/* Standing animation - legs only, no bounce */
.clawd-avatar-standing {
  display: inline-block;
}

.clawd-avatar-standing .clawd-leg-1 {
  transform-origin: center top;
  animation: clawd-leg-run-1 0.3s ease-in-out infinite;
}

.clawd-avatar-standing .clawd-leg-2 {
  transform-origin: center top;
  animation: clawd-leg-run-2 0.3s ease-in-out infinite;
}

@keyframes clawd-avatar-bounce {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-2px);
  }
}

@keyframes clawd-leg-run-1 {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-3px);
  }
}

@keyframes clawd-leg-run-2 {
  0%,
  100% {
    transform: translateY(-3px);
  }
  50% {
    transform: translateY(0);
  }
}

/* ===== Thinking Banner (above composer when agents are streaming) ===== */
.thinking-banner {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: hsl(var(--accent) / 5%);
  border: 1px solid hsl(var(--text) / 15%);
  border-bottom: none;
  border-radius: 8px 8px 0 0;
  color: hsl(var(--text) / 60%);
  font-size: 14px;
  cursor: pointer;
  user-select: none;
  animation: sending-pulse 1.5s ease-in-out infinite;
}

/* Thinking Claw'd animation - legs only */
.thinking-clawd {
  display: flex;
  align-items: center;
}

.thinking-clawd svg rect:nth-child(3),
.thinking-clawd svg rect:nth-child(5) {
  transform-origin: center top;
  animation: clawd-leg-run-1 0.3s ease-in-out infinite;
}

.thinking-clawd svg rect:nth-child(4),
.thinking-clawd svg rect:nth-child(6) {
  transform-origin: center top;
  animation: clawd-leg-run-2 0.3s ease-in-out infinite;
}

.thinking-banner:hover {
  background: hsl(var(--accent) / 10%);
}

/* When thinking banner is present, remove top border radius from hibernate banner or composer box */
.thinking-banner + .hibernate-banner {
  border-radius: 0;
  border-top-color: hsl(var(--text) / 10%);
}

.thinking-banner + .composer-box {
  border-radius: 0 0 8px 8px;
  border-top-color: hsl(var(--text) / 10%);
}

/* When both thinking and hibernate banners are present */
.thinking-banner + .hibernate-banner + .composer-box {
  border-radius: 0 0 8px 8px;
  border-top-color: hsl(var(--text) / 10%);
}

/* ===== Streaming Output Dialog ===== */
.stream-dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: hsl(var(--text) / 30%);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: stream-dialog-fade-in 0.15s ease-out;
}

@keyframes stream-dialog-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.stream-dialog {
  background: #fff;
  border-radius: 12px;
  width: min(90vw, 700px);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px hsl(var(--text) / 20%);
  animation: stream-dialog-slide-up 0.2s ease-out;
}

@keyframes stream-dialog-slide-up {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.stream-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
  flex-shrink: 0;
}

.stream-dialog-header h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: hsl(var(--text));
}

.stream-dialog-title-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Agent avatar bar -- replaces the dropdown selector */
.stream-agent-bar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 20px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
  flex-shrink: 0;
  overflow-x: auto;
}

.stream-agent-avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 4px 8px;
  border: none;
  border-radius: 6px;
  background: none;
  cursor: pointer;
  position: relative;
  transition: background 0.15s;
  opacity: 0.45;
}

.stream-agent-avatar-btn:hover {
  background: hsl(var(--text) / 5%);
  opacity: 0.7;
}

.stream-agent-avatar-btn.active {
  opacity: 1;
  background: none;
}

/* Scale down the avatar SVG inside the bar */
.stream-agent-avatar-btn .clawd-avatar-svg {
  width: 22px;
  height: 18px;
}

/* Wrapper around the avatar SVG so the dot is positioned relative to it */
.stream-agent-avatar-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.stream-agent-avatar-name {
  font-size: 10px;
  font-weight: 600;
  color: hsl(var(--text) / 40%);
  max-width: 64px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stream-agent-avatar-btn.active .stream-agent-avatar-name {
  color: hsl(var(--text));
}

.stream-agent-avatar-dot {
  position: absolute;
  top: -2px;
  right: -3px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: hsl(var(--accent));
}

/* Heartbeat-enabled agents: dot pulses like a beating heart */
.stream-agent-avatar-dot.heartbeat-pulse {
  animation: heartbeat-zoom 1.4s ease-in-out infinite;
}

@keyframes heartbeat-zoom {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.7;
  }
  14% {
    transform: scale(1.6);
    opacity: 1;
  }
  28% {
    transform: scale(1);
    opacity: 0.7;
  }
  42% {
    transform: scale(1.4);
    opacity: 1;
  }
  56% {
    transform: scale(1);
    opacity: 0.7;
  }
}

.stream-dialog-placeholder {
  color: hsl(var(--text) / 35%);
  text-align: center;
  padding: 60px 20px;
  font-family: Lato, sans-serif;
  font-size: 14px;
}

.stream-dialog-status {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 1px 6px;
  border-radius: 3px;
}

.stream-dialog-status-streaming {
  background: hsl(var(--accent) / 15%);
  color: hsl(var(--accent));
  animation: sending-pulse 1.5s ease-in-out infinite;
}

.stream-dialog-status-completed {
  background: hsl(150 50% 92%);
  color: hsl(150 50% 30%);
}

.stream-dialog-close {
  background: none;
  border: none;
  font-size: 22px;
  color: hsl(var(--text) / 50%);
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
  border-radius: 4px;
}

.stream-dialog-close:hover {
  background: hsl(var(--text) / 8%);
  color: hsl(var(--text));
}

.stream-dialog-body {
  flex: 1;
  overflow-y: auto;
  padding: 12px 20px;
  font-family: "SF Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.5;
  background: hsl(var(--text) / 3%);
}

.stream-dialog-empty {
  color: hsl(var(--text) / 40%);
  text-align: center;
  padding: 40px 0;
  font-family: Lato, sans-serif;
  font-size: 14px;
}

.stream-dialog-waiting {
  display: flex;
  align-items: center;
  gap: 8px;
  color: hsl(var(--text) / 50%);
  padding: 20px 0;
  font-family: Lato, sans-serif;
  font-size: 13px;
  font-style: italic;
}

.stream-dialog-waiting-icon {
  display: inline-block;
}

.stream-agent-section {
  margin-bottom: 8px;
}

.stream-agent-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  font-family: Lato, sans-serif;
  margin-bottom: 4px;
  padding: 4px 0;
  border-bottom: 1px solid hsl(var(--text) / 8%);
}

.stream-entry {
  margin: 0;
  padding: 1px 0;
}

.stream-entry pre {
  margin: 0;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: inherit;
  font-family: inherit;
  flex: 1;
}

.stream-thinking {
  color: hsl(var(--text) / 45%);
}

.stream-content {
  color: hsl(var(--text));
}

.stream-event {
  padding: 4px 0;
  font-size: 11px;
  font-weight: 600;
  color: hsl(30 60% 50%);
  letter-spacing: 0.2px;
}

.stream-thought-duration {
  padding: 6px 0 2px;
  font-size: 11px;
  font-weight: 600;
  color: hsl(140 50% 45%);
  letter-spacing: 0.2px;
}

.stream-session-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 16px 0;
  color: hsl(var(--text) / 0.4);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.stream-session-divider hr {
  flex: 1;
  border: none;
  border-top: 1px dashed hsl(var(--text) / 0.15);
  margin: 0;
}

.stream-session-divider span {
  white-space: nowrap;
}

.stream-tool-start,
.stream-tool-end,
.stream-tool-error {
  margin: 6px 0;
  padding: 0;
  border-radius: 6px;
  border: 1px solid hsl(var(--text) / 8%);
  overflow: hidden;
}

.stream-tool-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  background: hsl(var(--text) / 4%);
  border-bottom: 1px solid hsl(var(--text) / 6%);
}

.stream-tool-header-clickable {
  cursor: pointer;
  user-select: none;
}

.stream-tool-header-clickable:hover {
  background: hsl(var(--text) / 8%);
}

.stream-tool-collapsed .stream-tool-header,
.stream-tool-no-content .stream-tool-header {
  border-bottom: none;
}

.stream-tool-arrow {
  color: hsl(var(--text) / 40%);
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.stream-tool-start .stream-tool-header {
  color: hsl(210 60% 45%);
}

.stream-tool-end .stream-tool-header {
  color: hsl(150 50% 35%);
}

.stream-tool-error .stream-tool-header {
  color: hsl(0 60% 45%);
}

.stream-tool-name {
  font-weight: 700;
  font-size: 12px;
  white-space: nowrap;
}

.stream-tool-status {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 1px 6px;
  border-radius: 3px;
}

.stream-tool-status-ok {
  background: hsl(150 50% 92%);
  color: hsl(150 50% 30%);
}

.stream-tool-status-error {
  background: hsl(0 60% 93%);
  color: hsl(0 60% 40%);
}

.stream-tool-block {
  padding: 0;
}

.stream-tool-block-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: hsl(var(--text) / 40%);
  padding: 6px 10px 2px;
  font-family: Lato, sans-serif;
}

.stream-tool-block-content {
  margin: 0;
  padding: 4px 10px 8px;
  font-size: 11px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 200px;
  overflow-y: auto;
  font-family: "SF Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
}

.hibernate-banner span strong,
.hibernate-banner span b {
  font-weight: 700;
}

/* When hibernate banner is present, remove top border radius from composer-box */
.hibernate-banner + .composer-box {
  border-radius: 0 0 8px 8px;
  border-top-color: hsl(var(--text) / 10%);
}

/* Composer - Slack style */
.composer-wrapper {
  flex-shrink: 0;
  padding: 12px 20px 8px;
  background: var(--bg-main);
  position: relative;
}

.composer-wrapper.dragging {
  background: hsl(var(--accent) / 5%);
}

.drop-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: hsl(var(--accent) / 10%);
  border: 2px dashed hsl(var(--accent));
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  pointer-events: none;
}

.drop-overlay span {
  font-size: 16px;
  font-weight: 600;
  color: hsl(var(--accent));
}

.composer-box {
  border: 1px solid hsl(var(--text) / 20%);
  border-radius: 8px;
  background: hsl(var(--bg-center));
  overflow: hidden;
  position: relative;
  transition: border-color 0.15s;
}

.composer-box:hover,
.composer-box:focus-within {
  border-color: hsl(15 63.1% 45% / 50%);
}

.composer-toolbar {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 4px 8px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
}

.toolbar-btn {
  width: 28px;
  height: 28px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.1s,
    color 0.1s;
}

.toolbar-btn:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.toolbar-btn svg {
  width: 16px;
  height: 16px;
}

.toolbar-divider {
  width: 1px;
  height: 20px;
  background: hsl(var(--text) / 15%);
  margin: 0 4px;
}

.toolbar-btn.active {
  background: hsl(var(--accent) / 15%);
  color: var(--accent-color);
}

/* TipTap Editor */
.composer-editor {
  width: 100%;
  min-height: 44px;
  max-height: 200px;
  padding: 10px 12px;
  overflow-y: auto;
  outline: none;
  font-size: 15px;
  line-height: 1.5;
}

.composer-editor:focus {
  outline: none;
}

.composer-editor p {
  margin: 0;
}

.composer-editor p.is-editor-empty:first-child::before {
  content: attr(data-placeholder);
  float: left;
  color: var(--text-muted);
  pointer-events: none;
  height: 0;
}

.composer-editor strong {
  font-weight: 700;
}

.composer-editor em {
  font-style: italic;
}

.composer-editor s {
  text-decoration: line-through;
}

.composer-editor code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 13px;
  background: hsl(var(--text) / 8%);
  padding: 2px 4px;
  border-radius: 3px;
  color: #e01e5a;
}

.composer-editor pre {
  background: hsl(var(--text) / 8%);
  padding: 12px;
  border-radius: 6px;
  margin: 8px 0;
  overflow-x: auto;
}

.composer-editor pre code {
  background: none;
  padding: 0;
  color: var(--text-primary);
}

.composer-editor ul,
.composer-editor ol {
  margin: 4px 0;
  padding-left: 20px;
}

.composer-editor a {
  color: var(--accent-color);
  text-decoration: underline;
}

.composer-editor img {
  max-width: 200px;
  max-height: 150px;
  border-radius: 6px;
  margin: 4px 0;
}

.composer-input {
  width: 100%;
  min-height: 44px;
  max-height: 200px;
  padding: 10px 12px;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 15px;
  resize: none;
  outline: none;
}

.composer-input::placeholder {
  color: var(--text-muted);
}

/* Raw mode textarea */
.composer-raw-textarea {
  width: 100%;
  min-height: 24px;
  max-height: 200px;
  padding: 8px 12px;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 15px;
  line-height: 1.4;
  resize: none;
  outline: none;
  overflow-y: auto;
  field-sizing: content; /* Auto-size based on content */
}

.composer-raw-textarea::placeholder {
  color: var(--text-muted);
}

/* Textarea wrapper for layered highlighting */
.composer-textarea-wrap {
  position: relative;
  width: 100%;
}

.composer-textarea-wrap .composer-raw-textarea {
  position: relative;
  background: transparent;
  z-index: 2;
}

/* Format toggle button */
.format-toggle.active {
  color: var(--accent-color);
}

/* Preview toggle button */
.preview-toggle.active {
  color: var(--accent-color);
}

/* Composer preview - match message-content styling */
.composer-preview {
  min-height: 24px;
  max-height: 200px;
  padding: 8px 12px;
  background: transparent;
  border-radius: 8px;
  overflow-y: auto;
  font-size: 15px;
  line-height: 1.46668;
  color: var(--text-primary);
  word-wrap: break-word;
}

.composer-preview p {
  margin: 0 0 4px;
}

.composer-preview p:last-child {
  margin-bottom: 0;
}

.composer-preview ul,
.composer-preview ol {
  margin: 4px 0;
  padding-left: 20px;
}

.composer-preview code {
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 12px;
  background: hsl(var(--text) / 10%);
  padding: 2px 4px;
  border-radius: 3px;
  color: hsl(var(--accent));
}

.composer-preview pre {
  background: transparent;
  padding: 0;
  border-radius: 0;
  overflow-x: visible;
  margin: 4px 0;
  white-space: pre;
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 13px;
}

.composer-preview pre code {
  background: none;
  padding: 0;
  color: inherit;
  white-space: pre;
}

.composer-preview strong {
  font-weight: 600;
}

.composer-preview a {
  color: hsl(var(--accent));
  text-decoration: none;
}

.composer-preview a:hover {
  text-decoration: underline;
}

.composer-preview .table-wrapper {
  overflow-x: auto;
  margin: 4px 0;
}

.composer-preview table {
  border-collapse: collapse;
  width: 100%;
}

.composer-preview th,
.composer-preview td {
  border: 1px solid hsl(var(--text) / 15%);
  padding: 6px 10px;
  text-align: left;
}

.composer-preview th {
  background: hsl(var(--text) / 5%);
  font-weight: 600;
}

.composer-preview blockquote {
  border-left: 3px solid hsl(var(--text) / 30%);
  margin: 4px 0;
  padding-left: 12px;
  color: hsl(var(--text) / 70%);
}

.composer-preview .task-checkbox {
  margin-right: 6px;
}

.composer-preview hr {
  border: none;
  border-top: 1px solid hsl(var(--text) / 20%);
  margin: 8px 0;
}

.composer-preview img {
  max-width: 100%;
  border-radius: 4px;
}

.composer-preview-empty {
  color: var(--text-muted);
  font-style: italic;
}

.composer-bottom {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 8px 12px;
  padding-right: 48px;
  border-top: 1px solid hsl(var(--text) / 10%);
}

.composer-actions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.action-btn {
  width: 32px;
  height: 32px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.1s,
    color 0.1s;
}

.action-btn:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.action-btn svg {
  width: 20px;
  height: 20px;
}

.composer-send {
  position: absolute;
  bottom: 8px;
  right: 8px;
  width: 36px;
  height: 36px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.15s,
    color 0.15s;
}

.composer-send:hover,
.composer-send.has-content {
  background: hsl(15 63.1% 45%);
  color: #fff;
}

.composer-box:focus-within .composer-send {
  color: hsl(15 63.1% 45%);
}

.composer-box:focus-within .composer-send:hover,
.composer-box:focus-within .composer-send.has-content {
  background: hsl(15 63.1% 45%);
  color: #fff;
}

.composer-send svg {
  width: 20px;
  height: 20px;
}

.composer-disclaimer {
  text-align: center;
  font-size: 9px;
  color: hsl(var(--accent) / 20%);
  padding: 2px 0 0;
}

/* Attachment Preview */
.attachment-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 12px;
  background: hsl(var(--bg-center));
  border: 1px solid hsl(var(--text) / 20%);
  border-bottom: none;
  border-radius: 8px 8px 0 0;
  margin-bottom: -1px;
}

/* Image thumbnail preview */
.attachment-thumbnail {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
}

.attachment-thumbnail:hover {
  opacity: 0.9;
}

.attachment-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  background: #f4f4f4;
  border-radius: 4px;
  font-size: 13px;
  color: var(--text-secondary);
}

.attachment-item .remove {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0;
  font-size: 16px;
  line-height: 1;
}

.attachment-item .remove:hover {
  color: var(--text-primary);
}

.file-input-hidden {
  display: none;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40px 20px;
  color: var(--text-muted);
  font-size: 15px;
  gap: 24px;
}

.empty-clawd {
  opacity: 0.6;
}

.empty-clawd svg {
  width: 80px;
  height: 64px;
}

.empty-clawd .clawd-eye {
  transform-origin: center bottom;
  transform-box: fill-box;
  animation: blink 10s ease-in-out infinite;
}

/* Blocked state - agent hasn't initialized */
.blocked-state {
  gap: 12px;
}

.blocked-state .empty-clawd {
  opacity: 0.3;
}

.blocked-message {
  font-weight: 500;
  color: var(--text-primary);
}

.blocked-hint {
  font-size: 13px;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
  opacity: 0.3;
}

/* Responsive */
@media (max-width: 768px) {
  /* Header - 105% scale */
  .header {
    padding: 10px 17px;
  }

  .title {
    font-size: 16px;
  }

  /* Messages - 100% scale */
  .message {
    padding: 0 16px;
  }

  .streaming-indicator {
    padding: 10px 16px;
    margin: 4px 8px;
  }

  .message-sender {
    font-size: 15px;
  }

  .message-content {
    font-size: 15px;
  }

  .message-content code {
    font-size: 13px;
  }

  .message-content pre code {
    font-size: 13px;
  }

  .message-time {
    font-size: 12px;
  }

  /* Composer - 100% scale */
  .composer {
    padding: 10px 16px 16px;
    gap: 6px;
  }

  .composer-input {
    font-size: 16px;
    padding: 8px 10px;
  }

  .composer-send {
    padding: 8px 12px;
    font-size: 14px;
  }

  .composer-attach {
    padding: 8px;
  }

  .attachment-preview {
    padding: 6px 16px;
    font-size: 14px;
  }

  /* Code blocks - 100% scale */
  .code-preview {
    font-size: 12px;
  }

  /* System messages */
  .message-system-text {
    font-size: 12px;
  }

  /* Loading indicator */
  .loading-more {
    font-size: 12px;
  }
}

@media (max-width: 480px) {
  .header-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .message-sender {
    font-size: 15px;
  }

  .message-content {
    font-size: 15px;
  }

  .message-content code {
    font-size: 13px;
  }

  .message-content pre code {
    font-size: 13px;
  }

  .composer {
    flex-wrap: wrap;
  }

  .composer-input {
    order: 1;
    width: 100%;
    font-size: 16px;
  }

  .composer-attach {
    order: 2;
  }

  .composer-send {
    order: 3;
    flex: 1;
    font-size: 14px;
  }
}

/* Message highlight (when jumping to a reference) */
.message.highlight {
  animation: highlight-pulse 2s ease-out;
}

@keyframes highlight-pulse {
  0% {
    background-color: hsl(48 100% 90%);
  }
  100% {
    background-color: transparent;
  }
}

/* Message reference links */
.message-content a[href^="#"] {
  color: hsl(15 63.1% 45%);
  text-decoration: none;
  font-weight: 500;
  padding: 1px 4px;
  background: hsl(15 63.1% 95%);
  border-radius: 3px;
}

.message-content a[href^="#"]:hover {
  text-decoration: underline;
  background: hsl(15 63.1% 90%);
}

/* Composer file attachments preview */
.composer-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 12px;
  border-top: 1px solid #eee;
}

.composer-attachment-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  background: #f5f5f5;
  border-radius: 4px;
  font-size: 13px;
  color: var(--text-secondary);
}

.composer-attachment-item svg {
  flex-shrink: 0;
}

.attachment-name {
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-remove {
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px;
  border-radius: 3px;
  display: flex;
  align-items: center;
  color: var(--text-muted);
}

.attachment-remove:hover {
  background: #ddd;
  color: var(--text-primary);
}

/* ============================================
   ENHANCED MARKDOWN STYLES
   ============================================ */

/* Tables */
.table-wrapper {
  overflow-x: auto;
  margin: 12px 0;
}

.message-content table {
  border-collapse: collapse;
  width: 100%;
  font-size: 14px;
}

.message-content th,
.message-content td {
  border: 1px solid #ddd;
  padding: 8px 12px;
  text-align: left;
}

.message-content th {
  background: #f5f5f5;
  font-weight: 700;
}

.message-content tr:nth-child(even) {
  background: #fafafa;
}

.message-content tr:hover {
  background: #f0f0f0;
}

/* Mermaid Diagrams */
.mermaid-diagram {
  margin: 16px 0;
  overflow-x: auto;
  text-align: center;
}

.mermaid-diagram svg {
  max-width: 100%;
  height: auto;
}

.mermaid-error {
  border: 1px solid hsl(45 80% 60% / 30%);
  border-radius: 8px;
  padding: 8px 12px;
  background: hsl(45 80% 60% / 5%);
  margin: 8px 0;
}

.mermaid-error-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: hsl(45 80% 40%);
}

.mermaid-retry-btn {
  margin-left: auto;
  background: none;
  border: 1px solid hsl(45 80% 60% / 30%);
  border-radius: 4px;
  color: hsl(45 80% 40%);
  padding: 2px 8px;
  font-size: 12px;
  cursor: pointer;
}

.mermaid-retry-btn:hover {
  background: hsl(45 80% 60% / 10%);
}

.mermaid-error-details {
  margin-top: 8px;
}

.mermaid-error-details summary {
  font-size: 12px;
  color: hsl(var(--text) / 50%);
  cursor: pointer;
}

.mermaid-error-code {
  margin-top: 4px;
  font-size: 12px;
  max-height: 200px;
  overflow: auto;
  background: hsl(var(--text) / 5%);
  padding: 8px;
  border-radius: 4px;
}

@media (prefers-color-scheme: dark) {
  .mermaid-error-header {
    color: hsl(45 80% 65%);
  }
  .mermaid-retry-btn {
    color: hsl(45 80% 65%);
  }
}

/* Mermaid preview card - no border, no background */
.message-mermaid-card {
  /* margin handled by .message-block */
}

.message-mermaid-card .mermaid-diagram {
  margin: 0;
}

/* Image preview card - no border, no background */
.message-image-card {
  /* margin handled by .message-block */
}

.message-image-card img {
  max-width: 100%;
  border-radius: 8px;
  display: block;
}

.image-card-alt {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
}

/* Iframe preview card — no header, just a bordered container sized to the embed's native height */
.message-iframe-card {
  /* margin handled by .message-block wrapper */
  border: 1px solid hsl(var(--text) / 14%);
  border-radius: 8px;
  overflow: hidden;
}

/* Callouts/Admonitions (GitHub-style) */
.callout {
  margin: 12px 0;
  padding: 12px 16px;
  border-radius: 6px;
  border-left: 4px solid;
}

.callout-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  margin-bottom: 6px;
}

.callout-icon {
  font-size: 16px;
}

.callout-type {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.callout-content {
  font-size: 14px;
}

.callout-note {
  background: #e7f3ff;
  border-color: #2196f3;
}
.callout-note .callout-title {
  color: #1565c0;
}

.callout-tip {
  background: #e8f5e9;
  border-color: #4caf50;
}
.callout-tip .callout-title {
  color: #2e7d32;
}

.callout-important {
  background: #e8eaf6;
  border-color: #7c4dff;
}
.callout-important .callout-title {
  color: #5e35b1;
}

.callout-warning {
  background: #fff8e1;
  border-color: #ff9800;
}
.callout-warning .callout-title {
  color: #e65100;
}

.callout-caution {
  background: #ffebee;
  border-color: #f44336;
}
.callout-caution .callout-title {
  color: #c62828;
}

/* LaTeX/KaTeX Math */
.katex-display {
  margin: 16px 0;
  overflow-x: auto;
  overflow-y: hidden;
}

.katex {
  font-size: 1.1em;
}

/* Inline math should not break */
.katex-html {
  white-space: nowrap;
}

/* Task list checkboxes */
.task-checkbox {
  margin-right: 6px;
  pointer-events: none;
}

.message-content ul:has(.task-checkbox) {
  list-style: none;
  padding-left: 0;
}

.message-content li:has(.task-checkbox) {
  display: flex;
  align-items: flex-start;
  gap: 4px;
}

/* Strikethrough */
.message-content del {
  text-decoration: line-through;
  opacity: 0.7;
}

/* Footnotes */
.message-content .footnotes {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid #ddd;
  font-size: 13px;
}

.message-content .footnote-ref {
  font-size: 0.8em;
  vertical-align: super;
}

/* Horizontal rules */
.message-content hr {
  border: none;
  border-top: 1px solid #ddd;
  margin: 16px 0;
}

/* Details/Summary (collapsible) */
.message-content details {
  margin: 12px 0;
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 0;
}

.message-content summary {
  padding: 10px 14px;
  background: #f5f5f5;
  cursor: pointer;
  font-weight: 600;
  border-radius: 5px;
  user-select: none;
}

.message-content details[open] summary {
  border-bottom: 1px solid #ddd;
  border-radius: 5px 5px 0 0;
}

.message-content details > *:not(summary) {
  padding: 12px 14px;
}

.message-content summary:hover {
  background: #eee;
}

/* Definition lists */
.message-content dl {
  margin: 12px 0;
}

.message-content dt {
  font-weight: 700;
  margin-top: 12px;
}

.message-content dd {
  margin-left: 24px;
  color: var(--text-secondary);
}

/* Code Preview - File preview with syntax highlighting (Light Theme) */
/* Code Preview - Simple raw file display */
.code-preview {
  margin-top: 12px;
  border: 1px solid hsl(var(--text) / 15%);
  border-radius: 8px;
  overflow: hidden;
  background: #fafafa;
  font-family: Monaco, Menlo, Consolas, "Courier New", monospace;
  font-size: 13px;
}

.code-preview-label {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
}

.code-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  background: #f0f0f0;
  border-bottom: 1px solid hsl(var(--text) / 10%);
}

.code-preview-filename {
  font-size: 12px;
  color: var(--text-muted);
}

.code-preview-raw-btn {
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
  color: var(--text-muted);
  opacity: 0.6;
  transition: opacity 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-preview-raw-btn:hover {
  opacity: 1;
}

.code-preview-body {
  max-height: 400px;
  overflow: auto;
}

.code-preview-raw {
  margin: 0;
  padding: 8px 0;
}

.code-preview-line {
  display: flex;
  line-height: 1.5;
}

.code-preview-line-num {
  flex-shrink: 0;
  width: 40px;
  padding-right: 12px;
  text-align: right;
  color: #999;
  user-select: none;
}

.code-preview-line-text {
  flex: 1;
  padding-right: 12px;
  white-space: pre;
}

/* Message expand/collapse toggle - link style */
.message-expand-toggle {
  display: inline-block;
  margin-top: 4px;
  color: #666;
  cursor: pointer;
  font-size: 13px;
  user-select: none;
}

.message-expand-toggle:hover {
  color: #333;
  text-decoration: underline;
}

/* @clawd mention highlighting - matches message reference style */
.mention {
  display: inline;
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 500;
}

.mention-clawd {
  color: hsl(15 63.1% 45%);
  background: hsl(15 63.1% 95%);
}

.mention-clawd:hover {
  text-decoration: underline;
  background: hsl(15 63.1% 90%);
}

/* ============================================
   Plan Modal - Minimal Design
   ============================================ */

.plan-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: var(--text-muted);
  font-size: 12px;
  cursor: pointer;
  transition:
    background 0.1s,
    color 0.1s;
}

.plan-btn:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.plan-btn svg {
  width: 14px;
  height: 14px;
}

.plan-modal-overlay {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(
      circle at center,
      hsl(var(--bg-center)) 0%,
      hsl(var(--bg-center) / 85%) 50%,
      hsl(var(--bg-center) / 70%) 100%
    ),
    radial-gradient(circle, hsl(var(--text) / 8%) 1px, transparent 1px);
  background-size:
    100% 100%,
    16px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
  animation: plan-fade-in 0.15s ease;
}

@keyframes plan-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.plan-modal {
  background: hsl(var(--bg-center));
  border: 1px solid hsl(var(--text) / 12%);
  border-radius: 8px;
  width: min(720px, 90vw);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 24px hsl(var(--text) / 8%);
}

.plan-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid hsl(var(--text) / 8%);
}

.plan-modal-header h2 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.plan-modal-header .back-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-modal-header .back-btn:hover {
  background: hsl(var(--text) / 6%);
  color: var(--text-primary);
}

.plan-modal-header .back-btn svg {
  width: 16px;
  height: 16px;
}

.plan-modal-header .close-btn {
  background: none;
  border: none;
  font-size: 18px;
  color: var(--text-muted);
  cursor: pointer;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-modal-header .close-btn:hover {
  background: hsl(var(--text) / 6%);
  color: var(--text-primary);
}

.plan-modal-content {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}

.plan-loading,
.plan-error,
.plan-empty {
  text-align: center;
  padding: 32px 16px;
  color: var(--text-muted);
  font-size: 13px;
}

.plan-empty .hint {
  margin-top: 8px;
  font-size: 12px;
}

.plan-empty code {
  background: hsl(var(--text) / 6%);
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 11px;
}

/* Plan info */
.plan-info {
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid hsl(var(--text) / 8%);
}

.plan-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.plan-status .owner {
  font-size: 12px;
  color: var(--text-muted);
}

.status-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.status-badge.status-draft {
  background: hsl(var(--text) / 8%);
  color: var(--text-muted);
}
.status-badge.status-active {
  background: hsl(142 50% 45% / 15%);
  color: hsl(142 50% 35%);
}
.status-badge.status-completed {
  background: hsl(217 70% 50% / 15%);
  color: hsl(217 70% 40%);
}
.status-badge.status-cancelled {
  background: hsl(0 60% 50% / 15%);
  color: hsl(0 60% 40%);
}
.status-badge.status-todo {
  background: hsl(var(--text) / 8%);
  color: var(--text-muted);
}
.status-badge.status-doing {
  background: hsl(35 80% 50% / 15%);
  color: hsl(35 80% 35%);
}
.status-badge.status-done {
  background: hsl(142 50% 45% / 15%);
  color: hsl(142 50% 35%);
}
.status-badge.status-blocked {
  background: hsl(0 60% 50% / 15%);
  color: hsl(0 60% 40%);
}
.status-badge.status-pending {
  background: hsl(var(--text) / 8%);
  color: var(--text-muted);
}
.status-badge.status-skipped {
  background: hsl(var(--text) / 6%);
  color: hsl(var(--text) / 40%);
}

.plan-description {
  margin: 6px 0;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.5;
}

.plan-progress {
  margin-top: 10px;
}

.progress-bar {
  height: 4px;
  background: hsl(var(--text) / 10%);
  border-radius: 2px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: hsl(var(--accent));
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  margin-top: 4px;
  font-size: 11px;
  color: var(--text-muted);
}

/* Phases */
.phases-tree {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.phase-item {
  border-radius: 6px;
  overflow: hidden;
}

.phase-item.phase-completed {
  opacity: 0.6;
}

.phase-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 10px;
  cursor: pointer;
  border-radius: 6px;
  transition: background 0.1s ease;
}

.phase-header:hover {
  background: hsl(var(--text) / 4%);
}

.phase-header .expand-icon {
  font-size: 8px;
  color: var(--text-muted);
  width: 10px;
}

.phase-header .phase-icon {
  font-size: 12px;
}

.phase-header .phase-name {
  flex: 1;
  font-size: 13px;
  font-weight: 500;
}

.phase-header .phase-agent {
  display: flex;
  align-items: center;
}

.phase-tasks {
  padding: 4px 8px 8px 28px;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.phase-tasks .no-tasks {
  font-size: 12px;
  color: var(--text-muted);
  font-style: italic;
  padding: 4px 8px;
}

/* Task items */
.task-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.1s ease;
}

.task-item:hover {
  background: hsl(var(--text) / 4%);
}

.task-item .task-icon {
  font-size: 10px;
}

.task-item .task-priority {
  font-size: 10px;
  font-weight: 600;
  opacity: 0.8;
}

.task-item .task-title {
  flex: 1;
  font-size: 13px;
}

.task-item .task-title.completed {
  text-decoration: line-through;
  color: var(--text-muted);
}

.task-item .task-meta {
  display: flex;
  gap: 6px;
  font-size: 11px;
  color: var(--text-muted);
}

/* Task detail */
.task-detail {
  animation: plan-fade-in 0.15s ease;
}

.task-detail-header {
  margin-bottom: 12px;
}

.task-detail-header .task-id {
  font-size: 10px;
  color: var(--text-muted);
  font-family: "SF Mono", Menlo, monospace;
  margin-bottom: 2px;
}

.task-detail-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
}

.task-detail-header h3.completed {
  text-decoration: line-through;
  color: var(--text-muted);
}

.task-status-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.priority-badge {
  padding: 2px 8px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 600;
  color: white;
}

.tag-badge {
  padding: 2px 8px;
  border-radius: 3px;
  font-size: 11px;
  background: hsl(var(--text) / 8%);
  color: var(--text-secondary);
}

.task-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 8px;
  margin-bottom: 16px;
  padding: 12px;
  background: hsl(var(--text) / 3%);
  border-radius: 6px;
}

.task-meta-grid .meta-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.task-meta-grid label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
}

.task-meta-grid span {
  font-size: 12px;
}

.task-meta-grid .assignee-value {
  display: flex;
  align-items: center;
  gap: 4px;
}

.task-section {
  margin-bottom: 16px;
}

.task-section h4 {
  font-size: 12px;
  font-weight: 600;
  margin: 0 0 8px 0;
  color: var(--text-secondary);
}

.task-description {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-secondary);
  white-space: pre-wrap;
}

.attachments-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.attachment-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  font-size: 12px;
}

.attachment-item .attachment-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.attachment-item .attachment-name {
  font-weight: 500;
  color: hsl(var(--accent));
  text-decoration: none;
}

.attachment-item .attachment-name:hover {
  text-decoration: underline;
}

.attachment-item .attachment-meta {
  display: flex;
  align-items: center;
  gap: 4px;
  color: var(--text-muted);
  font-size: 10px;
}

.attachment-preview-img {
  display: block;
  max-width: 200px;
  max-height: 120px;
  cursor: pointer;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.comment-item {
  padding: 10px;
  background: hsl(var(--text) / 3%);
  border-radius: 6px;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 4px;
}

.comment-author {
  font-weight: 600;
  font-size: 12px;
}

.comment-time {
  font-size: 11px;
  color: var(--text-muted);
}

.comment-text {
  font-size: 13px;
  line-height: 1.5;
  white-space: pre-wrap;
}

/* Search Modal */
.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-muted);
  border-radius: 4px;
}

.search-btn:hover {
  color: hsl(var(--accent));
  background: hsl(var(--text) / 5%);
}

.search-btn svg {
  width: 16px;
  height: 16px;
}

/* Projects button */
.projects-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-muted);
  border-radius: 4px;
}

.projects-btn:hover {
  color: hsl(var(--accent));
  background: hsl(var(--text) / 5%);
}

.projects-btn svg {
  width: 16px;
  height: 16px;
}

.search-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: hsl(var(--text) / 40%);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 80px;
  z-index: 1000;
}

.search-modal {
  background: hsl(var(--bg));
  border-radius: 8px;
  width: 100%;
  max-width: 560px;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 32px hsl(var(--text) / 20%);
}

.search-modal-header {
  display: flex;
  align-items: center;
  padding: 12px;
  gap: 8px;
}

.search-modal.has-results .search-modal-header {
  border-bottom: 1px solid hsl(var(--text) / 8%);
}

.search-input {
  flex: 1;
  padding: 10px 12px;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 6px;
  font-size: 14px;
  background: hsl(var(--bg));
  color: var(--text-primary);
}

.search-input:focus {
  outline: none;
  border-color: hsl(var(--accent));
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  font-size: 24px;
  color: var(--text-muted);
  cursor: pointer;
  border-radius: 4px;
}

.search-close:hover {
  background: hsl(var(--text) / 5%);
  color: var(--text-primary);
}

.search-results {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.search-empty {
  padding: 24px;
  text-align: center;
  color: var(--text-muted);
  font-size: 13px;
}

.search-result-item {
  padding: 10px 12px;
  border-radius: 6px;
  cursor: pointer;
}

.search-result-item:hover {
  background: hsl(var(--text) / 5%);
}

.search-result-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.search-result-author {
  font-weight: 600;
  font-size: 12px;
  color: var(--text-primary);
}

.search-result-time {
  font-size: 11px;
  color: var(--text-muted);
}

.search-result-text {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-highlight {
  background: #ffeb3b;
  color: #000;
  padding: 0 2px;
  border-radius: 2px;
}

.search-loading,
.search-more {
  padding: 12px;
  text-align: center;
  color: var(--text-muted);
  font-size: 12px;
}

/* Search jump highlight animation */
.message.search-highlight-message {
  animation: search-pulse 2s ease-out;
}

@keyframes search-pulse {
  0% {
    background: hsl(48 100% 80%);
  }
  100% {
    background: transparent;
  }
}

/* ============================================================================
   Unread Messages - Badge & Separator
   ============================================================================ */

/* Unread Badge */
.unread-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  font-size: 11px;
  font-weight: 600;
  color: white;
  background: hsl(0 72% 51%);
  border-radius: 9px;
  line-height: 1;
}

/* Unread Separator */
.unread-separator {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 12px 0;
  padding: 0 16px;
}

.unread-separator-line {
  flex: 1;
  height: 1px;
  background: hsl(0 72% 51% / 60%);
}

.unread-separator-label {
  font-size: 11px;
  font-weight: 600;
  color: hsl(0 72% 51%);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ============================================================================
   Message Context Menu
   ============================================================================ */

.message-context-menu {
  position: fixed;
  z-index: 10000;
  min-width: 160px;
  background: hsl(var(--bg-center));
  border: 1px solid hsl(var(--border));
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  padding: 4px;
  animation: context-menu-appear 0.12s ease-out;
}

@keyframes context-menu-appear {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.context-menu-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent;
  color: hsl(var(--text));
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  border-radius: 4px;
  transition: background 0.1s;
}

.context-menu-item:hover {
  background: hsl(var(--bg));
}

.context-menu-item svg {
  width: 16px;
  height: 16px;
  opacity: 0.7;
}

.context-menu-item:hover svg {
  opacity: 1;
}

.context-menu-shortcut {
  margin-left: auto;
  font-size: 12px;
  opacity: 0.5;
  font-family: inherit;
}

.context-menu-item.disabled {
  opacity: 0.35;
  cursor: default;
}

.context-menu-item.disabled:hover {
  background: transparent;
}

/* Disable text selection globally - use copy buttons instead */
.app,
.home-page,
.modal-overlay {
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  user-select: none;
}

/* Allow text selection in the composer (user needs to edit their own text) */
.composer-editor,
.composer-editor * {
  -webkit-user-select: text;
  user-select: text;
}

/* Allow text selection in inputs */
input,
textarea {
  -webkit-user-select: text;
  user-select: text;
}

/* ============================================================================
   Projects Dialog
   ============================================================================ */

.projects-dialog {
  width: min(95vw, 1200px);
  height: min(95vh, 900px);
  display: flex;
  flex-direction: column;
}

.projects-dialog-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.projects-main {
  flex: 1;
  display: flex;
  overflow: hidden;
  border-top: 1px solid hsl(var(--border-dim));
}

/* Sidebar (file tree) */
.projects-sidebar {
  width: 280px;
  min-width: 200px;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid hsl(var(--border-dim));
  background: hsl(var(--bg-dim) / 0.5);
}

.projects-root-path {
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 600;
  color: hsl(var(--text-dim));
  background: hsl(var(--bg-dim));
  border-bottom: 1px solid hsl(var(--border-dim));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.projects-root-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

.projects-sidebar-toggle {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: hsl(var(--text-dim));
  cursor: pointer;
  border-radius: 4px;
  padding: 0;
}

.projects-sidebar-toggle:hover {
  background: hsl(var(--bg-highlight));
  color: hsl(var(--text));
}

/* Collapsed sidebar state */
.projects-sidebar.collapsed {
  width: 0;
  min-width: 0;
  border-right: none;
  overflow: hidden;
}

.projects-sidebar.collapsed .projects-root-path,
.projects-sidebar.collapsed .projects-tree,
.projects-sidebar.collapsed .projects-loading,
.projects-sidebar.collapsed .projects-error,
.projects-sidebar.collapsed .projects-empty {
  display: none;
}

/* Expand button shown when sidebar is collapsed */
.projects-expand-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 32px;
  height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8px;
  border: none;
  background: hsl(var(--bg-dim) / 0.8);
  border-right: 1px solid hsl(var(--border-dim));
  color: hsl(var(--text-dim));
  cursor: pointer;
}

.projects-expand-btn:hover {
  background: hsl(var(--bg-highlight));
  color: hsl(var(--text));
}

.projects-tree {
  flex: 1;
  overflow: auto;
  padding: 8px 0;
}

.projects-tree-node {
  user-select: none;
}

.projects-tree-item {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  cursor: pointer;
  font-size: 13px;
  color: hsl(var(--text));
  white-space: nowrap;
}

.projects-tree-item:hover {
  background: hsl(var(--bg-highlight));
}

.projects-tree-item.selected {
  background: hsl(var(--accent) / 0.15);
  color: hsl(var(--accent));
}

.projects-tree-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  color: hsl(var(--text-dim));
}

.projects-tree-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  color: hsl(var(--text-dim));
}

.projects-tree-item.selected .projects-tree-icon {
  color: hsl(var(--accent));
}

.projects-tree-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.projects-tree-size {
  font-size: 11px;
  color: hsl(var(--text-dim));
  margin-left: auto;
  padding-left: 8px;
}

.projects-tree-children {
  /* Indentation handled by padding-left in JS */
}

/* Loading and error states */
.projects-loading,
.projects-error,
.projects-empty {
  padding: 16px;
  font-size: 13px;
  color: hsl(var(--text-dim));
  text-align: center;
}

.projects-error {
  color: hsl(0 70% 60%);
}

/* Content panel (file viewer) */
.projects-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: hsl(var(--bg));
}

.projects-content-loading,
.projects-content-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: hsl(var(--text-dim));
}

.projects-file-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
  background: hsl(var(--bg-dim));
  border-bottom: 1px solid hsl(var(--border-dim));
}

.projects-file-path {
  font-size: 13px;
  font-weight: 500;
  color: hsl(var(--text));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.projects-file-meta {
  font-size: 12px;
  color: hsl(var(--text-dim));
  white-space: nowrap;
  margin-left: 16px;
}

.projects-file-content {
  flex: 1;
  margin: 0;
  padding: 16px;
  overflow: auto;
  font-size: 13px;
  line-height: 1.5;
  font-family: "SF Mono", "Menlo", "Monaco", "Consolas", monospace;
  background: hsl(var(--bg));
  color: hsl(var(--text));
  white-space: pre;
  tab-size: 2;
  -webkit-user-select: text;
  user-select: text;
}

.projects-file-content code {
  font-family: inherit;
}

/* Syntax highlighting for code viewer */
.code-lines {
  width: 100%;
  border-collapse: collapse;
  border-spacing: 0;
}

.code-line {
  line-height: 1.5;
}

.line-number {
  padding: 0 12px 0 8px;
  text-align: right;
  vertical-align: top;
  color: hsl(var(--text-dim));
  opacity: 0.5;
  user-select: none;
  -webkit-user-select: none;
  white-space: nowrap;
  border-right: 1px solid hsl(var(--border-dim));
  font-size: 12px;
}

.line-content {
  padding-left: 12px;
  white-space: pre;
  word-break: break-all;
}

/* Syntax highlighting colors */
.hl-keyword {
  color: #c586c0;
}

.hl-string {
  color: #ce9178;
}

.hl-number {
  color: #b5cea8;
}

.hl-comment {
  color: #6a9955;
  font-style: italic;
}

.hl-type {
  color: #4ec9b0;
}

/* Light mode overrides */
@media (prefers-color-scheme: light) {
  .hl-keyword {
    color: #af00db;
  }
  .hl-string {
    color: #a31515;
  }
  .hl-number {
    color: #098658;
  }
  .hl-comment {
    color: #008000;
  }
  .hl-type {
    color: #267f99;
  }
}

/* Loading spinner for lazy-loading directories */
.projects-tree-spinner {
  display: inline-block;
  width: 12px;
  height: 12px;
  border: 2px solid hsl(var(--text-dim));
  border-top-color: transparent;
  border-radius: 50%;
  animation: spinner-spin 0.8s linear infinite;
}

@keyframes spinner-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ============================================================================
   MCP Dialog & Button Styles
   ============================================================================ */

.mcp-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-muted);
  border-radius: 4px;
}

.mcp-btn:hover {
  color: hsl(var(--accent));
  background: hsl(var(--text) / 5%);
}

.mcp-btn svg {
  width: 16px;
  height: 16px;
}

/* Skills button in composer toolbar */
.skills-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-muted);
  border-radius: 4px;
}

.skills-btn:hover {
  color: hsl(var(--accent));
  background: hsl(var(--text) / 5%);
}

.skills-btn svg {
  width: 16px;
  height: 16px;
}

/* Skills dialog */
.skills-dialog {
  width: min(92vw, 720px);
  max-height: 75vh;
}

.skills-dialog-body {
  flex: 1;
  overflow: hidden;
  padding: 16px 20px;
  font-family: Lato, sans-serif;
  font-size: 14px;
  display: flex;
  flex-direction: column;
}

/* Skill list view — full width, collapsible sections */
.skills-list-view {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.skills-list-empty {
  font-size: 13px;
  color: hsl(var(--text) / 40%);
  padding: 12px 4px;
  line-height: 1.4;
}

/* Collapsible section (PROJECT / GLOBAL) */
.skills-section {
  display: flex;
  flex-direction: column;
}

.skills-section-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: 11px;
  font-weight: 700;
  color: hsl(var(--text) / 45%);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-radius: 4px;
  width: 100%;
  text-align: left;
}

.skills-section-header:hover {
  background: hsl(var(--text) / 4%);
}

.skills-section-count {
  font-weight: 500;
  color: hsl(var(--text) / 30%);
  font-size: 10px;
  margin-left: 2px;
}

.skills-section-items {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding-left: 4px;
}

/* Skill list item (inside sections) */
.skills-list-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 12px;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: 8px;
  text-align: left;
  transition: background 0.12s;
  width: 100%;
}

.skills-list-item:hover {
  background: hsl(var(--text) / 5%);
}

.skills-list-item-icon {
  color: hsl(var(--text) / 40%);
  margin-top: 1px;
  flex-shrink: 0;
}

.skills-list-item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.skills-list-item-name {
  font-size: 13px;
  font-weight: 500;
  color: hsl(var(--text));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.skills-list-item-desc {
  font-size: 11px;
  color: hsl(var(--text) / 50%);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Accordion: skill row + expanded editor wrapped together */
.skills-accordion-item {
  border-radius: 8px;
  transition: background 0.15s;
}

.skills-accordion-item.expanded {
  background: hsl(var(--text) / 5%);
}

.skills-accordion-item .skills-list-item {
  border-radius: 8px 8px 0 0;
}

.skills-accordion-item:not(.expanded) .skills-list-item {
  border-radius: 8px;
}

.skills-accordion-editor {
  padding: 4px 12px 12px 12px;
}

/* Back button in detail view header */
.skills-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: hsl(var(--text) / 60%);
  border-radius: 6px;
  margin-right: 4px;
  flex-shrink: 0;
}

.skills-back-btn:hover {
  background: hsl(var(--text) / 8%);
  color: hsl(var(--text));
}

/* Detail/editor view — full width */
.skills-detail-view {
  flex: 1;
  overflow-y: auto;
}

/* Field labels */
.skills-field-label {
  font-size: 11px;
  font-weight: 600;
  color: hsl(var(--text) / 50%);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.skills-editor-fields {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.skills-content-input {
  min-height: 160px;
  resize: vertical;
  font-family: "Fira Code", "Cascadia Code", monospace;
  font-size: 13px;
  line-height: 1.5;
}

.skills-scope-row {
  display: flex;
  gap: 16px;
  align-items: center;
}

.skills-scope-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: hsl(var(--text) / 80%);
  cursor: pointer;
}

.skills-scope-label input[type="radio"] {
  accent-color: hsl(var(--accent));
}

.skills-save-path {
  font-size: 11px;
  color: hsl(var(--text) / 40%);
  font-family: "Fira Code", "Cascadia Code", monospace;
  padding: 4px 0;
  word-break: break-all;
}

/* MCP server icon in the dialog bar */
.mcp-server-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: hsl(var(--text) / 8%);
  color: var(--text-muted);
  transition: all 0.2s;
}

.mcp-server-icon.connected {
  background: hsl(142 76% 36% / 15%);
  color: hsl(142 76% 36%);
}

.mcp-server-icon.disconnected {
  background: hsl(var(--text) / 6%);
  color: var(--text-muted);
  opacity: 0.6;
}

/* Error message */
.mcp-error {
  padding: 8px 12px;
  margin-bottom: 12px;
  background: hsl(0 70% 50% / 12%);
  border: 1px solid hsl(0 70% 50% / 20%);
  border-radius: 6px;
  color: hsl(0 70% 50%);
  font-size: 12px;
}

/* Empty state */
.mcp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 32px 16px;
  color: var(--text-muted);
  text-align: center;
}

.mcp-empty p {
  margin: 0;
  font-size: 13px;
}

/* ── Syntax highlighting tokens ─────────────────────────────────── */
/* Light theme (default) */
:root {
  --prism-comment: #6a737d;
  --prism-keyword: #d73a49;
  --prism-string: #032f62;
  --prism-function: #6f42c1;
  --prism-number: #005cc5;
  --prism-operator: #d73a49;
  --prism-class: #6f42c1;
  --prism-punctuation: #24292e;
  --prism-property: #005cc5;
  --prism-tag: #22863a;
  --prism-attr-name: #6f42c1;
  --prism-attr-value: #032f62;
  --prism-builtin: #e36209;
  --prism-inserted: #22863a;
  --prism-deleted: #b31d28;
  --prism-changed: #e36209;
}

/* Dark theme */
@media (prefers-color-scheme: dark) {
  :root {
    --prism-comment: #8b949e;
    --prism-keyword: #ff7b72;
    --prism-string: #a5d6ff;
    --prism-function: #d2a8ff;
    --prism-number: #79c0ff;
    --prism-operator: #ff7b72;
    --prism-class: #f0883e;
    --prism-punctuation: #c9d1d9;
    --prism-property: #79c0ff;
    --prism-tag: #7ee787;
    --prism-attr-name: #d2a8ff;
    --prism-attr-value: #a5d6ff;
    --prism-builtin: #ffa657;
    --prism-inserted: #aff5b4;
    --prism-deleted: #ffa198;
    --prism-changed: #ffa657;
  }
}

.token.comment,
.token.prolog,
.token.doctype,
.token.cdata {
  color: var(--prism-comment);
  font-style: italic;
}
.token.keyword,
.token.control,
.token.directive {
  color: var(--prism-keyword);
}
.token.string,
.token.char,
.token.template-string,
.token.url {
  color: var(--prism-string);
}
.token.function {
  color: var(--prism-function);
}
.token.number,
.token.boolean {
  color: var(--prism-number);
}
.token.operator,
.token.entity {
  color: var(--prism-operator);
}
.token.class-name,
.token.maybe-class-name {
  color: var(--prism-class);
}
.token.punctuation {
  color: var(--prism-punctuation);
}
.token.property,
.token.constant,
.token.variable {
  color: var(--prism-property);
}
.token.tag {
  color: var(--prism-tag);
}
.token.attr-name {
  color: var(--prism-attr-name);
}
.token.attr-value {
  color: var(--prism-attr-value);
}
.token.builtin,
.token.symbol {
  color: var(--prism-builtin);
}
.token.inserted {
  color: var(--prism-inserted);
}
.token.deleted {
  color: var(--prism-deleted);
}
.token.changed {
  color: var(--prism-changed);
}
.token.important,
.token.bold {
  font-weight: bold;
}
.token.italic {
  font-style: italic;
}

/* ── CSV table ─────────────────────────────────────────────────────────────── */
.artifact-csv-table {
  max-height: 400px;
  overflow: auto;
  border: 1px solid var(--border-color, #e1e4e8);
  border-radius: 4px;
}

.artifact-csv-table table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.artifact-csv-table th {
  position: sticky;
  top: 0;
  background: var(--card-header-bg, #f6f8fa);
  font-weight: 600;
  text-align: left;
  padding: 6px 10px;
  border-bottom: 2px solid var(--border-color, #e1e4e8);
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

.artifact-csv-table th:hover {
  background: var(--card-header-hover-bg, #eef0f2);
}

.artifact-csv-table td {
  padding: 4px 10px;
  border-bottom: 1px solid var(--border-color, #e1e4e8);
  white-space: nowrap;
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
}

.artifact-csv-table .row-odd {
  background: var(--card-bg, #ffffff);
}

.artifact-csv-table .row-even {
  background: var(--card-header-bg, #f6f8fa);
}

.artifact-csv-table tbody tr:hover {
  background: var(--card-header-hover-bg, #eef0f2);
}

.artifact-csv-truncated {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 10px;
  font-size: 12px;
  color: var(--text-secondary, #586069);
  border-top: 1px solid var(--border-color, #e1e4e8);
}

.artifact-csv-show-all {
  background: none;
  border: 1px solid var(--border-color, #e1e4e8);
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 12px;
  cursor: pointer;
  color: var(--text-secondary, #586069);
}

.artifact-csv-show-all:hover {
  background: var(--card-header-bg, #f6f8fa);
}

.artifact-csv-empty {
  padding: 24px;
  text-align: center;
  color: var(--text-secondary, #586069);
}

/* ── File previews ─────────────────────────────────────────────────────────── */
.file-preview-label {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary, #586069);
  margin-bottom: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-pdf-preview {
  margin: 8px 0;
  border: 1px solid var(--border-color, #e1e4e8);
  border-radius: 6px;
  overflow: hidden;
  padding: 8px;
}

.file-audio-player {
  margin: 8px 0;
  padding: 8px 12px;
  background: var(--card-bg, #f6f8fa);
  border-radius: 6px;
}

.file-video-player {
  margin: 8px 0;
}

/* ── Lazy viewport ─────────────────────────────────────────────────────────── */
.lazy-viewport-placeholder {
  background: var(--card-header-bg, #f6f8fa);
  border-radius: 6px;
  animation: lazy-pulse 1.5s ease-in-out infinite;
}

@keyframes lazy-pulse {
  0%,
  100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.7;
  }
}

.mermaid-placeholder {
  padding: 24px;
  text-align: center;
  color: var(--text-secondary, #586069);
  font-style: italic;
}

/* Dark mode overrides */
@media (prefers-color-scheme: dark) {
  .artifact-csv-table {
    border-color: var(--border-color, #30363d);
  }
  .artifact-csv-table th {
    background: var(--card-header-bg, #161b22);
    border-color: var(--border-color, #30363d);
  }
  .artifact-csv-table td {
    border-color: var(--border-color, #30363d);
  }
  .artifact-csv-table .row-odd {
    background: var(--card-bg, #0d1117);
  }
  .artifact-csv-table .row-even {
    background: var(--card-header-bg, #161b22);
  }
  .file-pdf-preview {
    border-color: var(--border-color, #30363d);
  }
  .file-audio-player {
    background: var(--card-bg, #161b22);
  }
  .lazy-viewport-placeholder {
    background: var(--card-header-bg, #161b22);
  }
}

/* ── Artifact iframe ───────────────────────────────────────────── */
.artifact-iframe-container {
  position: relative;
  border-radius: 4px;
  overflow: hidden;
  background: #fff;
}

@media (prefers-color-scheme: dark) {
  .artifact-iframe-container {
    background: #1a1a2e;
  }
}

.artifact-error-banner {
  padding: 8px 12px;
  background: #ffeef0;
  color: #b31d28;
  font-size: 12px;
  font-family: monospace;
  border-bottom: 1px solid #fdaeb7;
}

@media (prefers-color-scheme: dark) {
  .artifact-error-banner {
    background: #3d1f28;
    color: #ffa198;
    border-color: #5a2030;
  }
}

/* ── Artifact SVG inline renderer ─────────────────────────────── */
.artifact-renderer-svg {
  display: flex;
  justify-content: center;
  padding: 12px;
}

.artifact-renderer-svg svg {
  max-width: 100%;
  height: auto;
}

/* ── Artifact placeholder (markdown / csv / code fallbacks) ───── */
.artifact-renderer-placeholder {
  padding: 12px;
  font-size: 12px;
  font-family: monospace;
  white-space: pre-wrap;
  overflow: auto;
  max-height: 400px;
  background: transparent;
}

/* ── Chart artifacts ───────────────────────────────────────────── */
.artifact-chart {
  padding: 12px 0;
}

.artifact-chart-title {
  font-weight: 600;
  font-size: 14px;
  text-align: center;
  margin-bottom: 8px;
}

.artifact-chart-error {
  padding: 12px;
  color: var(--text-secondary, #586069);
}

.artifact-chart-error pre {
  margin-top: 8px;
  font-size: 12px;
  max-height: 200px;
  overflow: auto;
}

/* Recharts dark mode overrides */
@media (prefers-color-scheme: dark) {
  .recharts-default-tooltip {
    background-color: #1c2128 !important;
    border-color: #30363d !important;
  }

  .recharts-cartesian-grid line {
    stroke: #30363d;
  }

  .recharts-text {
    fill: #8b949e;
  }
}

/* ── Artifact Preview Card (mirrors .message-article-card) ────────────── */
.artifact-preview-card {
  display: flex;
  gap: 12px;
  margin-top: 12px;
  padding: 12px;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
  user-select: none;
}

.artifact-preview-card:hover {
  border-color: hsl(var(--accent) / 30%);
}

.artifact-preview-card:focus-visible {
  outline: 2px solid var(--accent-color);
  outline-offset: 2px;
}

.artifact-preview-card--streaming {
  opacity: 0.7;
  cursor: default;
}

/* Type badge */
.artifact-preview-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

/* Content area */
.artifact-preview-content {
  flex: 1;
  min-width: 0;
}

.artifact-preview-title {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4px;
}

/* Thumbnail variants */
.artifact-preview-thumbnail {
  font-size: 12px;
  color: var(--text-muted);
  max-height: 48px;
  overflow: hidden;
}

.artifact-preview-code {
  margin: 0;
  font-family: Monaco, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.4;
  color: var(--text-secondary);
  white-space: pre;
  overflow: hidden;
  max-height: 44px;
}

.artifact-preview-meta {
  font-size: 12px;
  color: var(--text-muted);
}

.artifact-preview-badge-interactive {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
  background: hsl(var(--accent) / 12%);
  color: var(--accent-color);
}

.artifact-preview-svg {
  max-height: 60px;
  overflow: hidden;
}

.artifact-preview-svg svg {
  max-height: 60px;
  width: auto;
}

/* Streaming state */
.artifact-preview-streaming {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
}

.artifact-preview-streaming .loading-spinner {
  width: 14px;
  height: 14px;
}

/* ── Streaming Artifact Card ──────────────────────────────────────────── */
.artifact-card {
  border: 1px solid hsl(var(--text) / 12%);
  border-radius: 8px;
  margin-top: 12px;
  overflow: hidden;
}

.artifact-card--streaming {
  border-color: var(--accent-color, hsl(var(--accent)));
  border-style: dashed;
  animation: artifact-pulse 2s ease-in-out infinite;
}

.artifact-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: hsl(var(--text) / 4%);
  border-bottom: 1px solid hsl(var(--text) / 8%);
}

.artifact-card-header--streaming {
  background: hsl(var(--text) / 6%);
}

.artifact-card-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.artifact-card-title {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artifact-card-streaming-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-muted);
  margin-left: auto;
  flex-shrink: 0;
}

.artifact-card-spinner {
  width: 12px;
  height: 12px;
  border: 2px solid hsl(var(--text) / 15%);
  border-top-color: var(--accent-color);
  border-radius: 50%;
  animation: artifact-spin 0.8s linear infinite;
}

.artifact-card-body--streaming {
  max-height: 200px;
  overflow-y: auto;
  overflow-anchor: auto;
}

.artifact-card-preview {
  margin: 0;
  padding: 8px 12px;
  font-size: 12px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--text-secondary);
}

@keyframes artifact-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes artifact-pulse {
  0%,
  100% {
    border-color: var(--accent-color);
  }
  50% {
    border-color: hsl(var(--text) / 12%);
  }
}

/* Entrance animation when streaming ends and full card appears */
.artifact-preview-card {
  animation: artifact-appear 0.25s ease-out;
}

@keyframes artifact-appear {
  from {
    opacity: 0.6;
    transform: scale(0.99);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ── Artifact Modal (fullscreen overlay) ─────────────────────────────── */
.artifact-modal-overlay {
  position: fixed;
  inset: 0;
  background: hsl(var(--text) / 40%);
  backdrop-filter: blur(4px);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

.artifact-modal-content {
  width: 90vw;
  max-width: 1200px;
  height: 85vh;
  background: hsl(var(--bg-center));
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 20px 60px hsl(var(--text) / 20%);
}

.artifact-modal-content:focus {
  outline: none;
}

/* Toolbar */
.artifact-modal-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
  flex-shrink: 0;
}

.artifact-modal-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.artifact-modal-title {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artifact-modal-actions {
  display: flex;
  gap: 4px;
}

.artifact-modal-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0;
}

.artifact-modal-actions button:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.artifact-modal-close {
  margin-left: 4px;
}

/* Body — scrollable, no max-height */
.artifact-modal-body {
  flex: 1;
  overflow: auto;
  padding: 16px;
}

.artifact-modal-body iframe {
  width: 100%;
  height: 100%;
  border: none;
  min-height: 400px;
}

.artifact-modal-markdown {
  max-width: 720px;
  line-height: 1.7;
}

/* Error state */
.artifact-error {
  padding: 8px 0;
}

.artifact-error-msg {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  margin-bottom: 8px;
  border-radius: 4px;
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: hsl(0 65% 50%);
  font-size: 13px;
}

/* Mobile */
@media (max-width: 640px) {
  .artifact-modal-content {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
  }
}

/* Auth login prompt */
.login-prompt-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg, #1a1a1a);
  z-index: 9999;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 32px;
  background: var(--surface, #222);
  border: 1px solid var(--border, #333);
  border-radius: 8px;
  width: 320px;
}

.login-prompt h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--text, #e0e0e0);
}

.login-prompt p {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted, #999);
  text-align: center;
}

.login-prompt input {
  width: 100%;
  padding: 8px 12px;
  background: var(--input-bg, #111);
  border: 1px solid var(--border, #333);
  border-radius: 4px;
  color: var(--text, #e0e0e0);
  font-size: 14px;
  box-sizing: border-box;
}

.login-prompt button {
  width: 100%;
  padding: 8px;
  background: hsl(15 63.1% 59.6%);
  border: none;
  border-radius: 4px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.login-prompt button:hover {
  opacity: 0.9;
}

.login-error {
  font-size: 12px;
  color: hsl(0 65% 60%);
}

/* ── Inline artifact rendering (chart / svg) ──────────────────── */
.message-inline-artifact {
  margin: 8px 0;
  border: 1px solid hsl(var(--text) / 10%);
  border-radius: 8px;
  overflow: hidden;
  max-width: 100%;
}

.message-inline-artifact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  font-size: 12px;
  color: hsl(var(--text) / 60%);
  border-bottom: 1px solid hsl(var(--text) / 8%);
  background: hsl(var(--text) / 3%);
}

.message-inline-artifact-title {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-inline-artifact-actions {
  display: flex;
  gap: 4px;
  opacity: 0;
  transition: opacity 0.15s;
  flex-shrink: 0;
}

.message-inline-artifact:hover .message-inline-artifact-actions {
  opacity: 1;
}

.message-inline-artifact-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 6px;
  border: 1px solid hsl(var(--text) / 15%);
  border-radius: 4px;
  background: transparent;
  color: hsl(var(--text) / 60%);
  font-size: 11px;
  cursor: pointer;
  transition:
    background 0.1s,
    color 0.1s;
}

.message-inline-artifact-action-btn:hover {
  background: hsl(var(--text) / 8%);
  color: hsl(var(--text) / 90%);
}

.message-inline-artifact-body {
  padding: 12px;
}

.message-inline-artifact-loading {
  padding: 24px;
  text-align: center;
  color: hsl(var(--text) / 50%);
  font-size: 13px;
}

/* Streaming skeleton pulse for inline chart/SVG */
.message-inline-artifact--streaming .message-inline-artifact-body {
  min-height: 120px;
  background: linear-gradient(90deg, hsl(var(--text) / 4%) 25%, hsl(var(--text) / 8%) 50%, hsl(var(--text) / 4%) 75%);
  background-size: 200% 100%;
  animation: inline-artifact-skeleton 1.5s ease-in-out infinite;
}

@keyframes inline-artifact-skeleton {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ── Sidebar Panel ────────────────────────────────────────────────────────── */
.sidebar-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: 80vw;
  min-width: 600px;
  max-width: 95vw;
  height: 100vh;
  z-index: 200;
  background: hsl(var(--bg));
  border-left: 1px solid hsl(var(--text) / 12%);
  box-shadow: -4px 0 20px hsl(0 0% 0% / 10%);
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  outline: none;
}

.sidebar-panel.open {
  transform: translateX(0);
}

.sidebar-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
  background: hsl(var(--bg));
  flex-shrink: 0;
  gap: 12px;
  min-height: 52px;
}

.sidebar-panel-header-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  flex: 1;
}

.sidebar-panel-header-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.sidebar-panel-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  color: hsl(var(--text) / 50%);
  text-decoration: none;
  transition:
    background 0.15s,
    color 0.15s;
}

.sidebar-panel-action-icon:hover {
  background: hsl(var(--text) / 10%);
  color: hsl(var(--text) / 90%);
}

.sidebar-panel-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.sidebar-panel-type-badge--embed {
  background: hsl(220 70% 55%);
}

.sidebar-panel-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-panel-close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  border-radius: 6px;
  cursor: pointer;
  flex-shrink: 0;
  transition:
    background 0.15s,
    color 0.15s;
}

.sidebar-panel-close-btn:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.sidebar-panel-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

.sidebar-panel-iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

.sidebar-panel-artifact {
  flex: 1;
  overflow: auto;
  padding: 16px;
}

/* File viewer inside sidebar */
.sidebar-panel-file {
  flex: 1;
  overflow: auto;
  display: flex;
  flex-direction: column;
}

/* ── Sidebar Backdrop ────────────────────────────────────────────────────── */
.sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 199; /* below sidebar (200) — both portaled to body in DOM order */
  background: hsl(0 0% 0% / 30%);
  backdrop-filter: blur(6px);
}

/* Embed artifact card variant */
.artifact-preview-card--embed {
  cursor: pointer;
}

/* ── File preview card (in messages) ─────────────────────────────────────── */
.file-preview-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  flex-shrink: 0;
}

.file-preview-card {
  max-width: 320px;
}

/* Image wrapper: inline preview above the card */
.message-image-wrapper {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* ── Sidebar file renderers ───────────────────────────────────────────────── */
.sidebar-file-pdf {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sidebar-file-html {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sidebar-html-iframe {
  flex: 1;
  width: 100%;
  border: none;
  background: white;
}

.sidebar-file-actions {
  display: flex;
  gap: 8px;
  padding: 10px 16px;
  border-bottom: 1px solid hsl(var(--text) / 10%);
  flex-shrink: 0;
}

.sidebar-file-action-btn {
  font-size: 13px;
  padding: 5px 12px;
  border-radius: 5px;
  color: var(--text-secondary);
  text-decoration: none;
  border: 1px solid hsl(var(--text) / 15%);
  transition:
    background 0.15s,
    color 0.15s;
}

.sidebar-file-action-btn:hover {
  background: hsl(var(--text) / 8%);
  color: var(--text-primary);
}

.sidebar-pdf-object {
  flex: 1;
  width: 100%;
  height: 100%;
  display: block;
  border: none;
}

.sidebar-pdf-fallback {
  padding: 32px;
  text-align: center;
  color: var(--text-secondary);
}

.sidebar-file-image {
  flex: 1;
  overflow: auto;
  padding: 16px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.sidebar-image-full {
  max-width: 100%;
  height: auto;
  border-radius: 6px;
}

.sidebar-file-media {
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sidebar-file-media-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
}

.sidebar-file-loading,
.sidebar-file-error {
  padding: 24px 16px;
  font-size: 13px;
  color: var(--text-muted);
}

.sidebar-file-error {
  color: hsl(0 70% 55%);
}

/* Syntax-highlighted code in sidebar */
.sidebar-code-pre {
  margin: 0;
  padding: 16px;
  font-family: Monaco, Menlo, Consolas, "Courier New", monospace;
  font-size: 13px;
  line-height: 1.6;
  white-space: pre;
  overflow: auto;
  flex: 1;
  background: hsl(var(--bg));
  color: var(--text-primary);
}

/* CSV table in sidebar */
.csv-table-wrapper {
  overflow: auto;
  padding: 16px;
  flex: 1;
}

.csv-table {
  border-collapse: collapse;
  font-size: 13px;
  min-width: 100%;
}

.csv-table th,
.csv-table td {
  padding: 6px 12px;
  border: 1px solid hsl(var(--text) / 12%);
  text-align: left;
  white-space: nowrap;
}

.csv-table th {
  background: hsl(var(--text) / 5%);
  font-weight: 600;
  color: var(--text-primary);
  position: sticky;
  top: 0;
}

.csv-table td {
  color: var(--text-secondary);
}

.csv-table tr:hover td {
  background: hsl(var(--text) / 3%);
}
</file>

</files>
